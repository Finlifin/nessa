private const _sync_rwlock_read_lock: fn(i64) -> Any = .__sync_rwlock_read_lock'builtin
private const _sync_rwlock_try_read_lock: fn(i64) -> bool = .__sync_rwlock_try_read_lock'builtin
private const _sync_rwlock_read_unlock: fn(i64) -> Unit = .__sync_rwlock_read_unlock'builtin
private const _sync_rwlock_write_lock: fn(i64) -> Any = .__sync_rwlock_write_lock'builtin
private const _sync_rwlock_try_write_lock: fn(i64) -> bool = .__sync_rwlock_try_write_lock'builtin
private const _sync_rwlock_write_unlock: fn(i64) -> Unit = .__sync_rwlock_write_unlock'builtin
private const _sync_rwlock_get: fn(i64) -> Any = .__sync_rwlock_get'builtin
private const _sync_rwlock_set: fn(i64, Any) -> Unit = .__sync_rwlock_set'builtin

