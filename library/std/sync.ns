pub enum ChannelError {
    pub Closed,
    pub Full,
    pub Empty,
}
derive Eq, PartialEq for ChannelError

impl Display for ChannelError {
    pub fn to_string(self) -> String {
        self match {
            ChannelError.Closed => "ChannelError.Closed",
            ChannelError.Full => "ChannelError.Full",
            ChannelError.Empty => "ChannelError.Empty",
        }
    }
}

pub struct Channel {
    handle_id: i64,
}
derive Eq, PartialEq for Channel

impl Display for Channel {
    pub fn to_string(self) -> String {
        "Channel(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl Channel {
    pub fn new(.capacity: i64 = 0) -> Channel = Channel { handle_id: _sync_chan_new(capacity) }
    pub fn unbuffered() -> Channel = Channel { handle_id: _sync_chan_new(0) }
    pub fn buffered(capacity: i64) -> Channel = Channel { handle_id: _sync_chan_new(capacity) }

    pub fn send(self, val: Any) -> !ChannelError Unit {
        let code = _sync_chan_send(self.handle_id, val)
        if code == 0 { () } else { error ChannelError.Closed }
    }

    pub fn try_send(self, val: Any) -> !ChannelError Unit {
        let code = _sync_chan_try_send(self.handle_id, val)
        when {
            code == 0 => ()
            code == 1 => error ChannelError.Closed
            else => error ChannelError.Full
        }
    }

    pub fn recv(self) -> !ChannelError Any {
        let (code, val) = _sync_chan_recv(self.handle_id)
        if code == 0 { val } else { error ChannelError.Closed }
    }

    pub fn try_recv(self) -> !ChannelError Any {
        let (code, val) = _sync_chan_try_recv(self.handle_id)
        when {
            code == 0 => val
            code == 1 => error ChannelError.Closed
            else => error ChannelError.Empty
        }
    }

    pub fn close(self) -> Unit = _sync_chan_close(self.handle_id)
    pub fn is_closed(self) -> bool = _sync_chan_is_closed(self.handle_id)
    pub fn len(self) -> i64 = _sync_chan_len(self.handle_id)
    pub fn is_empty(self) -> bool = _sync_chan_len(self.handle_id) == 0
}

pub struct Mutex {
    handle_id: i64,
}
derive Eq, PartialEq for Mutex

impl Display for Mutex {
    pub fn to_string(self) -> String {
        "Mutex(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl Mutex {
    pub fn new(initial: Any) -> Mutex = Mutex { handle_id: _sync_mutex_new(initial) }
    pub fn lock(self) -> Any = _sync_mutex_lock(self.handle_id)
    pub fn try_lock(self) -> bool = _sync_mutex_try_lock(self.handle_id)
    pub fn unlock(self) -> Unit = _sync_mutex_unlock(self.handle_id)
    pub fn get(self) -> Any = _sync_mutex_get(self.handle_id)
    pub fn set(self, val: Any) -> Unit = _sync_mutex_set(self.handle_id, val)
    pub fn is_locked(self) -> bool = _sync_mutex_is_locked(self.handle_id)

    pub fn with_lock(self, f: fn(Any) -> Any) -> Any {
        var acquired = false
        defer {
            if acquired {
                _sync_mutex_unlock(self.handle_id)
            }
        }
        let current = _sync_mutex_lock(self.handle_id)
        acquired = true
        f(current)
    }

    pub fn update(self, f: fn(Any) -> Any) -> Any {
        var acquired = false
        defer {
            if acquired {
                _sync_mutex_unlock(self.handle_id)
            }
        }
        let current = _sync_mutex_lock(self.handle_id)
        acquired = true
        let next = f(current)
        _sync_mutex_set(self.handle_id, next)
        next
    }
}

pub struct RwLock {
    handle_id: i64,
}
derive Eq, PartialEq for RwLock

impl Display for RwLock {
    pub fn to_string(self) -> String {
        "RwLock(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl RwLock {
    pub fn new(initial: Any) -> RwLock = RwLock { handle_id: _sync_rwlock_new(initial) }
    pub fn read_lock(self) -> Any = _sync_rwlock_read_lock(self.handle_id)
    pub fn try_read_lock(self) -> bool = _sync_rwlock_try_read_lock(self.handle_id)
    pub fn read_unlock(self) -> Unit = _sync_rwlock_read_unlock(self.handle_id)
    pub fn write_lock(self) -> Any = _sync_rwlock_write_lock(self.handle_id)
    pub fn try_write_lock(self) -> bool = _sync_rwlock_try_write_lock(self.handle_id)
    pub fn write_unlock(self) -> Unit = _sync_rwlock_write_unlock(self.handle_id)
    pub fn get(self) -> Any = _sync_rwlock_get(self.handle_id)
    pub fn set(self, val: Any) -> Unit = _sync_rwlock_set(self.handle_id, val)

    pub fn with_read(self, f: fn(Any) -> Any) -> Any {
        var acquired = false
        defer {
            if acquired {
                _sync_rwlock_read_unlock(self.handle_id)
            }
        }
        let current = _sync_rwlock_read_lock(self.handle_id)
        acquired = true
        f(current)
    }

    pub fn with_write(self, f: fn(Any) -> Any) -> Any {
        var acquired = false
        defer {
            if acquired {
                _sync_rwlock_write_unlock(self.handle_id)
            }
        }
        let current = _sync_rwlock_write_lock(self.handle_id)
        acquired = true
        let next = f(current)
        _sync_rwlock_set(self.handle_id, next)
        next
    }
}

pub struct Semaphore {
    handle_id: i64,
}
derive Eq, PartialEq for Semaphore

impl Display for Semaphore {
    pub fn to_string(self) -> String {
        "Semaphore(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl Semaphore {
    pub fn new(permits: i64) -> Semaphore = Semaphore { handle_id: _sync_sem_new(permits) }
    pub fn acquire(self) -> Unit = _sync_sem_acquire(self.handle_id)
    pub fn try_acquire(self) -> bool = _sync_sem_try_acquire(self.handle_id)
    pub fn release(self, .count: i64 = 1) -> Unit = _sync_sem_release(self.handle_id, count)
    pub fn release_many(self, count: i64) -> Unit = _sync_sem_release(self.handle_id, count)
    pub fn available(self) -> i64 = _sync_sem_available(self.handle_id)

    pub fn with_permit(self, f: fn() -> Any) -> Any {
        var acquired = false
        defer {
            if acquired {
                _sync_sem_release(self.handle_id, 1)
            }
        }
        _sync_sem_acquire(self.handle_id)
        acquired = true
        f()
    }
}

pub struct Once {
    handle_id: i64,
}
derive Eq, PartialEq for Once

impl Display for Once {
    pub fn to_string(self) -> String {
        "Once(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl Once {
    pub fn new() -> Once = Once { handle_id: _sync_once_new() }

    pub fn call_once(self, init: fn() -> Any) -> Any {
        defer { _sync_once_abort(self.handle_id) }
        let (code, existing) = _sync_once_begin(self.handle_id)
        if code == 0 {
            return existing
        }
        let computed = init()
        _sync_once_complete(self.handle_id, computed)
        computed
    }

    pub fn get(self) -> ?Any {
        let (ready, val) = _sync_once_get(self.handle_id)
        if ready { val } else { null }
    }

    pub fn is_completed(self) -> bool {
        let (ready, _) = _sync_once_get(self.handle_id)
        ready
    }
}

pub struct Lazy {
    once: Once,
    init_fn: fn() -> Any,
}

impl Lazy {
    pub fn new(init: fn() -> Any) -> Lazy = Lazy { once: Once.new(), init_fn: init }
    pub fn force(self) -> Any = self.once.call_once(self.init_fn)
    pub fn is_initialized(self) -> bool = self.once.is_completed()
}

pub struct Barrier {
    handle_id: i64,
}
derive Eq, PartialEq for Barrier

impl Display for Barrier {
    pub fn to_string(self) -> String {
        "Barrier(#" ++ _to_string_raw(self.handle_id) ++ ")"
    }
}

impl Barrier {
    pub fn new(parties: i64) -> Barrier = Barrier { handle_id: _sync_barrier_new(parties) }
    pub fn wait(self) -> bool = _sync_barrier_wait(self.handle_id)
}

pub struct AtomicInt {
    handle_id: i64,
}
derive Eq, PartialEq for AtomicInt

impl Display for AtomicInt {
    pub fn to_string(self) -> String {
        "AtomicInt(" ++ _to_string_raw(_sync_atomic_load(self.handle_id)) ++ ")"
    }
}

impl AtomicInt {
    pub fn new(initial: i64) -> AtomicInt = AtomicInt { handle_id: _sync_atomic_new(initial) }
    pub fn zero() -> AtomicInt = AtomicInt { handle_id: _sync_atomic_new(0) }
    pub fn load(self) -> i64 = _sync_atomic_load(self.handle_id)
    pub fn store(self, val: i64) -> Unit = _sync_atomic_store(self.handle_id, val)
    pub fn swap(self, val: i64) -> i64 = _sync_atomic_swap(self.handle_id, val)
    pub fn fetch_add(self, delta: i64) -> i64 = _sync_atomic_fetch_add(self.handle_id, delta)
    pub fn fetch_sub(self, delta: i64) -> i64 = _sync_atomic_fetch_add(self.handle_id, 0 - delta)
    pub fn compare_exchange(self, expected: i64, desired: i64) -> (bool, i64) {
        _sync_atomic_cas(self.handle_id, expected, desired)
    }
}

pub struct AtomicBool {
    handle_id: i64,
}
derive Eq, PartialEq for AtomicBool

impl Display for AtomicBool {
    pub fn to_string(self) -> String {
        if _sync_atomic_load(self.handle_id) != 0 {
            "AtomicBool(true)"
        } else {
            "AtomicBool(false)"
        }
    }
}

impl AtomicBool {
    pub fn new(initial: bool) -> AtomicBool {
        AtomicBool { handle_id: _sync_atomic_new(if initial { 1 } else { 0 }) }
    }

    pub fn load(self) -> bool = _sync_atomic_load(self.handle_id) != 0

    pub fn store(self, val: bool) -> Unit {
        _sync_atomic_store(self.handle_id, if val { 1 } else { 0 })
    }

    pub fn swap(self, val: bool) -> bool {
        _sync_atomic_swap(self.handle_id, if val { 1 } else { 0 }) != 0
    }

    pub fn compare_exchange(self, expected: bool, desired: bool) -> (bool, bool) {
        let exp_num = if expected { 1 } else { 0 }
        let des_num = if desired { 1 } else { 0 }
        let (ok, prev) = _sync_atomic_cas(self.handle_id, exp_num, des_num)
        (ok, prev != 0)
    }
}
