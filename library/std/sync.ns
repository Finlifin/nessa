private const _sync_chan_send: fn(i64, Any) -> i64 = .__sync_chan_send'builtin
private const _sync_chan_try_send: fn(i64, Any) -> i64 = .__sync_chan_try_send'builtin
private const _sync_chan_recv: fn(i64) -> (i64, Any) = .__sync_chan_recv'builtin
private const _sync_chan_try_recv: fn(i64) -> (i64, Any) = .__sync_chan_try_recv'builtin
