private const _sync_sem_try_acquire: fn(i64) -> bool = .__sync_sem_try_acquire'builtin
private const _sync_sem_release: fn(i64, i64) -> Unit = .__sync_sem_release'builtin
private const _sync_sem_available: fn(i64) -> i64 = .__sync_sem_available'builtin

