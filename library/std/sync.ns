private const _sync_mutex_try_lock: fn(i64) -> bool = .__sync_mutex_try_lock'builtin
private const _sync_mutex_unlock: fn(i64) -> Unit = .__sync_mutex_unlock'builtin
private const _sync_mutex_get: fn(i64) -> Any = .__sync_mutex_get'builtin
private const _sync_mutex_set: fn(i64, Any) -> Unit = .__sync_mutex_set'builtin
