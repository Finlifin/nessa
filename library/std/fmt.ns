-- std.fmt — checked printf-style string formatting and formatted stream output.

use .builtin.*
use .traits.*

const native_sprintf: fn(String, List) -> (i64, String) = .__fmt_sprintf'builtin
const native_concat: fn(String, String) -> String = .str_concat'builtin
const native_print: fn(Any) -> Unit = .print'builtin
const native_eprint: fn(Any) -> Unit = .eprint'builtin
const native_panic: fn(Any) -> NoReturn = .panic'builtin

pub enum FormatError {
    pub InvalidSpec(message: String),
    pub MissingArg(message: String),
    pub TypeMismatch(message: String),
    pub OutOfRange(message: String),
}

derive Eq, PartialEq for FormatError

impl Display for FormatError {
    pub fn to_string(self) -> String {
        self match {
            FormatError.InvalidSpec(message) => native_concat("invalid format specifier: ", message),
            FormatError.MissingArg(message) => native_concat("missing format argument: ", message),
            FormatError.TypeMismatch(message) => native_concat("format type mismatch: ", message),
            FormatError.OutOfRange(message) => native_concat("format argument out of range: ", message),
        }
    }
}

-- Format `args` according to `spec`, returning a typed `FormatError` on failure.
pub fn format_list(spec: String, args: List) -> !FormatError String {
    let (code, payload) = native_sprintf(spec, args)
    when {
        code == 0 => payload
        code == 1 => error FormatError.InvalidSpec(payload)
        code == 2 => error FormatError.MissingArg(payload)
        code == 3 => error FormatError.TypeMismatch(payload)
        code == 4 => error FormatError.OutOfRange(payload)
        else => error FormatError.InvalidSpec(payload)
    }
}

-- Checked variadic formatting according to `spec`.
pub fn format(spec: String, ...args: List) -> !FormatError String {
    format_list(spec, args)
}

-- Format `args` according to `spec`, panicking with the diagnostic message on error.
pub fn sprintf_list(spec: String, args: List) -> String {
    format_list(spec, args) match {
        formatted! => formatted,
        error err => native_panic(err.to_string()),
    }
}

-- Panicking variadic convenience formatter.
pub fn sprintf(spec: String, ...args: List) -> String {
    sprintf_list(spec, args)
}

-- Alias for `sprintf` when a format specification is statically known to be valid.
pub fn must_format(spec: String, ...args: List) -> String {
    sprintf_list(spec, args)
}

-- Format and write directly to stdout without adding a trailing newline.
pub fn printf(spec: String, ...args: List) -> Unit {
    native_print(sprintf_list(spec, args))
}

-- Format and write directly to stderr without adding a trailing newline.
pub fn eprintf(spec: String, ...args: List) -> Unit {
    native_eprint(sprintf_list(spec, args))
}
