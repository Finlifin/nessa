-- std.io — input / output streams, nominal file handles, RAII scoping, and console capability effects.

use .builtin.{
    Any,
    Display,
    Eq,
    IntoIterator,
    IterationStep,
    Iterator,
    List,
    NoReturn,
    PartialEq,
    String,
    Type,
    Unit,
    bool,
    f64,
    i64,
}
use .path.to_path_string
use .traits.*

private const print_native: fn(Any) -> Unit = .print'builtin
private const println_native: fn(Any) -> Unit = .println'builtin
private const eprint_native: fn(Any) -> Unit = .eprint'builtin
private const eprintln_native: fn(Any) -> Unit = .eprintln'builtin

private const native_io_flush_stdout: fn() -> (i64, String) = .__io_flush_stdout'builtin
private const native_io_flush_stderr: fn() -> (i64, String) = .__io_flush_stderr'builtin
private const native_file_open: fn(String, String) -> (i64, i64, String) = .__file_open'builtin
private const native_file_temp: fn() -> (i64, i64, String) = .__file_temp'builtin
private const native_file_close: fn(i64) -> (i64, String) = .__file_close'builtin
private const native_file_is_open: fn(i64) -> bool = .__file_is_open'builtin
private const native_file_flush: fn(i64) -> (i64, String) = .__file_flush'builtin
private const native_file_read_all: fn(i64) -> (i64, String) = .__file_read_all'builtin
private const native_file_read_line: fn(i64, bool) -> (i64, ?String, String) = .__file_read_line'builtin
private const native_file_read_chars: fn(i64, i64) -> (i64, ?String, String) = .__file_read_chars'builtin
private const native_file_read_bytes: fn(i64, i64) -> (i64, List, String) = .__file_read_bytes'builtin
private const native_file_write_str: fn(i64, String) -> (i64, String) = .__file_write_str'builtin
private const native_file_write_bytes: fn(i64, List) -> (i64, String) = .__file_write_bytes'builtin
private const native_file_seek: fn(i64, i64, i64) -> (i64, i64, String) = .__file_seek'builtin

private const native_panic: fn(Any) -> NoReturn = .panic'builtin
private const native_to_string: fn(Any) -> String = .to_string'builtin
private const native_is_error_value: fn(Any) -> bool = .__is_error_value'builtin
private const native_unwrap_ok_value: fn(Any) -> Any = .__unwrap_ok_value'builtin
private const native_forward_error_value: fn(Any) -> NoReturn = .__forward_error_value'builtin

-- Values with a Display implementation visible here print their Display
-- text; all other values keep the native representation.
pub fn print(value: Any) -> Unit {
    value match {
        shown: Display => print_native(shown.to_string()),
        _ => print_native(value),
    }
}

pub fn println(value: Any) -> Unit {
    value match {
        shown: Display => println_native(shown.to_string()),
        _ => println_native(value),
    }
}

pub fn eprint(value: Any) -> Unit {
    value match {
        shown: Display => eprint_native(shown.to_string()),
        _ => eprint_native(value),
    }
}

pub fn eprintln(value: Any) -> Unit {
    value match {
        shown: Display => eprintln_native(shown.to_string()),
        _ => eprintln_native(value),
    }
}

pub const type_of: fn(Any) -> Type = .type_of'builtin
pub const to_i64: fn(Any) -> i64 = .to_i64'builtin
pub const to_f64: fn(Any) -> f64 = .to_f64'builtin
pub const to_string: fn(Any) -> String = .to_string'builtin

-- Console capability effects and handler scopes.
pub effect console_print(text: String) -> Unit
pub effect console_println(text: String) -> Unit
pub effect console_read_line() -> !IoError ?String

pub fn with_stdio(thunk: fn() -> #console_print #console_println #console_read_line Any) -> Any {
    let result = thunk()# {
        console_print(text) => print_native(text),
        console_println(text) => println_native(text),
        console_read_line() => File.stdin().read_line(),
    }
    if native_is_error_value(result) {
        return result
    }
    native_unwrap_ok_value(result)
}

private struct CaptureBuffer {
    text: String,
}

pub fn capture_output(thunk: fn() -> #console_print #console_println Any) -> (String, Any) {
    let state = CaptureBuffer { text: "" }
    let result = thunk()# {
        console_print(text) => {
            state.text = state.text ++ text
        },
        console_println(text) => {
            state.text = state.text ++ text ++ "\n"
        },
    }
    if native_is_error_value(result) {
        return native_forward_error_value(result)
    }
    (state.text, native_unwrap_ok_value(result))
}

pub enum IoError {
    pub NotFound(message: String),
    pub PermissionDenied(message: String),
    pub AlreadyExists(message: String),
    pub InvalidInput(message: String),
    pub UnexpectedEof(message: String),
    pub Closed(message: String),
    pub BrokenPipe(message: String),
    pub Other(message: String),
}
derive Eq, PartialEq for IoError

impl Display for IoError {
    pub fn to_string(self) -> String {
        self match {
            IoError.NotFound(message) => "NotFound: " ++ message,
            IoError.PermissionDenied(message) => "PermissionDenied: " ++ message,
            IoError.AlreadyExists(message) => "AlreadyExists: " ++ message,
            IoError.InvalidInput(message) => "InvalidInput: " ++ message,
            IoError.UnexpectedEof(message) => "UnexpectedEof: " ++ message,
            IoError.Closed(message) => "Closed: " ++ message,
            IoError.BrokenPipe(message) => "BrokenPipe: " ++ message,
            IoError.Other(message) => "Other: " ++ message,
        }
    }
}

pub fn io_error_from_code(code: i64, message: String) -> IoError {
    when {
        code == 1 => IoError.NotFound(message)
        code == 2 => IoError.PermissionDenied(message)
        code == 3 => IoError.AlreadyExists(message)
        code == 4 => IoError.InvalidInput(message)
        code == 5 => IoError.UnexpectedEof(message)
        code == 6 => IoError.Closed(message)
        code == 7 => IoError.BrokenPipe(message)
        else => IoError.Other(message)
    }
}

pub enum OpenMode {
    pub read,
    pub write,
    pub append,
    pub read_write,
    pub create_new,
}
derive Eq, PartialEq, Display for OpenMode

private fn open_mode_flag(mode: OpenMode) -> String {
    mode match {
        OpenMode.read => "rb",
        OpenMode.write => "wb",
        OpenMode.append => "ab",
        OpenMode.read_write => "r+",
        OpenMode.create_new => "w+x",
    }
}

pub enum SeekFrom {
    pub start(offset: i64),
    pub current(offset: i64),
    pub end(offset: i64),
}
derive Eq, PartialEq for SeekFrom

impl Display for SeekFrom {
    pub fn to_string(self) -> String {
        self match {
            SeekFrom.start(offset) => "SeekFrom.start(" ++ native_to_string(offset) ++ ")",
            SeekFrom.current(offset) => "SeekFrom.current(" ++ native_to_string(offset) ++ ")",
            SeekFrom.end(offset) => "SeekFrom.end(" ++ native_to_string(offset) ++ ")",
        }
    }
}

pub fn flush_stdout() -> !IoError Unit {
    let (code, msg) = native_io_flush_stdout()
    if code == 0 { () } else { error io_error_from_code(code, msg) }
}

pub fn flush_stderr() -> !IoError Unit {
    let (code, msg) = native_io_flush_stderr()
    if code == 0 { () } else { error io_error_from_code(code, msg) }
}

pub struct File {
    handle_id: i64,
}
derive Eq, PartialEq for File

impl Display for File {
    pub fn to_string(self) -> String {
        if native_file_is_open(self.handle_id) {
            "file (open)"
        } else {
            "file (closed)"
        }
    }
}

impl File {
    pub fn stdin() -> File = File { handle_id: 0 }
    pub fn stdout() -> File = File { handle_id: 1 }
    pub fn stderr() -> File = File { handle_id: 2 }

    pub fn open(path: Any, .mode: OpenMode = OpenMode.read) -> !IoError File {
        let raw_path = to_path_string(path)
        let (code, id, msg) = native_file_open(raw_path, open_mode_flag(mode))
        if code == 0 {
            File { handle_id: id }
        } else {
            error io_error_from_code(code, msg)
        }
    }

    pub fn create(path: Any) -> !IoError File = File.open(path, mode = OpenMode.write)

    pub fn append(path: Any) -> !IoError File = File.open(path, mode = OpenMode.append)

    pub fn create_new(path: Any) -> !IoError File = File.open(path, mode = OpenMode.create_new)

    private fn open_raw_any(path: Any, mode: OpenMode) -> Any {
        let opened: !IoError File = File.open(path, mode = mode)
        opened
    }

    pub fn with_open(
        path: Any,
        .mode: OpenMode = OpenMode.read,
        body: fn(File) -> Any,
    ) -> Any {
        let opened = File.open_raw_any(path, mode)
        if native_is_error_value(opened) {
            return opened
        }
        let f = native_unwrap_ok_value(opened).as(File)
        defer { let _ = f.close() }
        let res = body(f)
        if native_is_error_value(res) {
            return res
        }
        native_unwrap_ok_value(res)
    }

    pub fn temp() -> !IoError File {
        let (code, id, msg) = native_file_temp()
        if code == 0 {
            File { handle_id: id }
        } else {
            error io_error_from_code(code, msg)
        }
    }

    pub fn close(self) -> !IoError Unit {
        let (code, msg) = native_file_close(self.handle_id)
        if code == 0 { () } else { error io_error_from_code(code, msg) }
    }

    pub fn is_open(self) -> bool = native_file_is_open(self.handle_id)

    pub fn flush(self) -> !IoError Unit {
        let (code, msg) = native_file_flush(self.handle_id)
        if code == 0 { () } else { error io_error_from_code(code, msg) }
    }

    pub fn read_to_string(self) -> !IoError String {
        let (code, content) = native_file_read_all(self.handle_id)
        if code == 0 { content } else { error io_error_from_code(code, content) }
    }

    pub fn read_line(self, .keep_newline: bool = false) -> !IoError ?String {
        let (code, line, msg) = native_file_read_line(self.handle_id, keep_newline)
        if code == 0 { line } else { error io_error_from_code(code, msg) }
    }

    pub fn read_chars(self, count: i64) -> !IoError ?String {
        let (code, chunk, msg) = native_file_read_chars(self.handle_id, count)
        if code == 0 { chunk } else { error io_error_from_code(code, msg) }
    }

    pub fn read_bytes(self, .max_bytes: i64 = -1) -> !IoError List {
        let (code, bytes, msg) = native_file_read_bytes(self.handle_id, max_bytes)
        if code == 0 { bytes } else { error io_error_from_code(code, msg) }
    }

    pub fn write(self, text: String) -> !IoError Unit {
        let (code, msg) = native_file_write_str(self.handle_id, text)
        if code == 0 { () } else { error io_error_from_code(code, msg) }
    }

    pub fn write_line(self, text: String) -> !IoError Unit {
        self.write(text ++ "\n")
    }

    pub fn write_bytes(self, data: List) -> !IoError Unit {
        let (code, msg) = native_file_write_bytes(self.handle_id, data)
        if code == 0 { () } else { error io_error_from_code(code, msg) }
    }

    pub fn seek(self, pos: SeekFrom) -> !IoError i64 {
        let (whence, offset) = pos match {
            SeekFrom.start(off) => (0, off),
            SeekFrom.current(off) => (1, off),
            SeekFrom.end(off) => (2, off),
        }
        let (code, new_pos, msg) = native_file_seek(self.handle_id, whence, offset)
        if code == 0 { new_pos } else { error io_error_from_code(code, msg) }
    }

    pub fn position(self) -> !IoError i64 {
        self.seek(SeekFrom.current(0))
    }

    pub fn lines(self, .keep_newline: bool = false, .close_on_eof: bool = false) -> FileLines {
        FileLines {
            file: self,
            keep_newline: keep_newline,
            close_on_eof: close_on_eof,
            finished: false,
        }
    }
}

pub struct FileLines {
    file: File,
    keep_newline: bool,
    close_on_eof: bool,
    finished: bool,
}

impl Iterator for FileLines {
    assoc Item: Type = String
    pub fn next(self) -> IterationStep(String) {
        if self.finished {
            return IterationStep(String).done
        }
        self.file.read_line(keep_newline = self.keep_newline) match {
            line_opt! => line_opt match {
                line? => IterationStep(String).yielded(line),
                _ => {
                    self.finished = true
                    if self.close_on_eof {
                        let _ = self.file.close()
                    }
                    IterationStep(String).done
                },
            },
            error err => {
                self.finished = true
                if self.close_on_eof {
                    let _ = self.file.close()
                }
                native_panic(err.to_string())
            },
        }
    }
}

impl IntoIterator for FileLines {
    assoc Iter: Type = FileLines
    pub fn into_iter(self) -> FileLines = self
}

pub fn stdin() -> File = File.stdin()
pub fn stdout() -> File = File.stdout()
pub fn stderr() -> File = File.stderr()

pub fn read_lines(path: Any, .keep_newline: bool = false) -> !IoError FileLines {
    let file = File.open(path, mode = OpenMode.read)!
    file.lines(keep_newline = keep_newline, close_on_eof = true)
}
