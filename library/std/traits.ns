-- The native comparison keeps exact mixed numeric rules. Public methods return
-- nominal values; no type-pool index is embedded in the native ABI.
const scalar_compare: fn(Any, Any) -> ?i64 = .__scalar_cmp'builtin
fn scalar_order(left: Any, right: Any) -> ?Ordering {
    let result = scalar_compare(left, right)
    if result == null { null }
    else if result.as(i64) == -1 { Ordering.less }
    else if result.as(i64) == 1 { Ordering.greater }
    else { Ordering.equal }
}

impl Ord for u8 {
    pub fn cmp(self, other: Self) -> Ordering { scalar_order(self, other).as(Ordering) }
}
impl PartialOrd for u8 {
    pub fn partial_cmp(self, other: Self) -> ?Ordering { scalar_order(self, other) }
}

impl Ord for u16 {
    pub fn cmp(self, other: Self) -> Ordering { scalar_order(self, other).as(Ordering) }
}
impl PartialOrd for u16 {
    pub fn partial_cmp(self, other: Self) -> ?Ordering { scalar_order(self, other) }
}

