-- std.traits — explicit scalar trait implementations.
-- Equality shares the VM comparison rules, including NaN != NaN for floats.
use .builtin.*
use .ordering.*

const scalar_equal: fn(Any, Any) -> bool = .__scalar_eq'builtin
const display_value: fn(Any) -> String = .to_string'builtin

impl Eq for u8 {
    pub fn eq(self, other: Self) -> bool { scalar_equal(self, other) }
}
impl PartialEq for u8 {
    pub fn eq(self, other: Self) -> bool { scalar_equal(self, other) }
}
impl Display for u8 {
    pub fn to_string(self) -> String { display_value(self) }
}

impl Eq for u16 {
    pub fn eq(self, other: Self) -> bool { scalar_equal(self, other) }
}
impl PartialEq for u16 {
    pub fn eq(self, other: Self) -> bool { scalar_equal(self, other) }
}
impl Display for u16 {
    pub fn to_string(self) -> String { display_value(self) }
}

