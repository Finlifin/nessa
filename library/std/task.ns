-- std.task — cooperative task control, structured Future combinators, timeouts, and introspection.

use .builtin.*
use .collections.*
use .time.Duration
use .traits.*

private const _panic: fn(Any) -> NoReturn = .panic'builtin
private const _to_string_raw: fn(Any) -> String = .to_string'builtin
private const _time_sleep_ms: fn(i64) -> Unit = .__time_sleep_ms'builtin
private const _task_yield: fn() -> Unit = .__task_yield'builtin
private const _task_await_all: fn(List) -> List = .__task_await_all'builtin
private const _task_await_any: fn(List) -> Any = .__task_await_any'builtin
private const _task_is_ready: fn(Future) -> bool = .__task_is_ready'builtin
private const _task_await_indexed: fn(List) -> (i64, Any) = .__task_await_indexed'builtin
private const _task_current_id: fn() -> i64 = .__task_current_id'builtin
private const _task_tree_snapshot: fn() -> String = .__task_tree_snapshot'builtin

private async effect timeout_work() -> Any
private async effect timeout_timer(ms: i64) -> Unit

pub struct TimeoutError {
    pub millis: i64,

    pub fn new(millis: i64) -> TimeoutError = TimeoutError { millis: millis }
}
derive Eq, PartialEq for TimeoutError

impl Display for TimeoutError {
    pub fn to_string(self) -> String {
        "TimeoutError(" ++ _to_string_raw(self.millis) ++ "ms)"
    }
}

pub enum Either {
    pub left(value: Any),
    pub right(value: Any),

    pub fn is_left(self) -> bool {
        self matches Either.left(_)
    }

    pub fn is_right(self) -> bool {
        self matches Either.right(_)
    }

    pub fn unwrap_left(self) -> Any {
        self match {
            Either.left(v) => v,
            Either.right(_) => _panic("Either.unwrap_left called on right"),
        }
    }

    pub fn unwrap_right(self) -> Any {
        self match {
            Either.right(v) => v,
            Either.left(_) => _panic("Either.unwrap_right called on left"),
        }
    }
}

impl PartialEq for Either {
    pub fn eq(self, other: Self) -> bool {
        self match {
            Either.left(a) => other match {
                Either.left(b) => a == b,
                Either.right(_) => false,
            },
            Either.right(a) => other match {
                Either.right(b) => a == b,
                Either.left(_) => false,
            },
        }
    }
}

impl Display for Either {
    pub fn to_string(self) -> String {
        self match {
            Either.left(v) => "left(" ++ _to_string_raw(v) ++ ")",
            Either.right(v) => "right(" ++ _to_string_raw(v) ++ ")",
        }
    }
}

pub use Either.{left, right}

pub fn yield_now() -> Unit {
    _task_yield()
}

pub fn sleep_ms(ms: i64) -> Unit {
    _time_sleep_ms(ms)
}

pub fn sleep(dur: Duration) -> Unit {
    _time_sleep_ms(dur.as_millis())
}

pub fn current_id() -> i64 {
    _task_current_id()
}

pub fn tree_snapshot() -> String {
    _task_tree_snapshot()
}

pub fn is_ready(f: Future) -> bool {
    _task_is_ready(f)
}

pub fn await_all(futures: List) -> List {
    _task_await_all(futures)
}

pub fn await_any(futures: List) -> Any {
    _task_await_any(futures)
}

pub fn await_first(first: Future, second: Future) -> Either {
    let pair = List()
    pair.push(first)
    pair.push(second)
    let (idx, value) = _task_await_indexed(pair)
    if idx == 0 {
        Either.left(value)
    } else {
        Either.right(value)
    }
}

private fn _make_timeout_err(ms: i64) -> !TimeoutError Any {
    error TimeoutError.new(ms)
}

pub fn with_timeout(ms: i64, thunk: fn() -> Any) -> Any {
    if ms < 0 {
        let e: Any = _make_timeout_err(ms)
        return e
    }
    handles timeout_work() => thunk()
    handles timeout_timer(d: i64) => _time_sleep_ms(d)
    let pair = List()
    pair.push(timeout_work())
    pair.push(timeout_timer(ms))
    let (idx, value) = _task_await_indexed(pair)
    if idx == 0 {
        value
    } else {
        let e: Any = _make_timeout_err(ms)
        e
    }
}
