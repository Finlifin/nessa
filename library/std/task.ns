-- std.task — cooperative task control, structured `async effect` combinators, timeouts, and introspection.

use .builtin.*
use .collections.*
use .time.Duration
use .traits.*

private const native_panic: fn(Any) -> NoReturn = .panic'builtin
private const native_to_string: fn(Any) -> String = .to_string'builtin
private const native_is_error_value: fn(Any) -> bool = .__is_error_value'builtin
private const native_unwrap_ok_value: fn(Any) -> Any = .__unwrap_ok_value'builtin
private const native_forward_error_value: fn(Any) -> NoReturn = .__forward_error_value'builtin
private const native_time_sleep_ms: fn(i64) -> Unit = .__time_sleep_ms'builtin
private const native_task_yield: fn() -> Unit = .__task_yield'builtin
private const native_task_await_all: fn(List) -> List = .__task_await_all'builtin
private const native_task_await_any: fn(List) -> Any = .__task_await_any'builtin
private const native_task_is_ready: fn(Future) -> bool = .__task_is_ready'builtin
private const native_task_await_indexed: fn(List) -> (i64, Any) = .__task_await_indexed'builtin
private const native_task_current_id: fn() -> i64 = .__task_current_id'builtin
private const native_task_tree_snapshot: fn() -> String = .__task_tree_snapshot'builtin

private async effect timeout_work() -> Any
private async effect timeout_timer(ms: i64) -> Unit
private async effect par_item_work(item: Any) -> Any
private async effect par_for_each_work(item: Any) -> Any
private async effect race_branch_work(branch: fn() -> Any) -> Any

pub struct TimeoutError {
    pub millis: i64,

    pub fn new(millis: i64) -> TimeoutError = TimeoutError { millis: millis }
}
derive Eq, PartialEq for TimeoutError

impl Display for TimeoutError {
    pub fn to_string(self) -> String {
        "TimeoutError(" ++ native_to_string(self.millis) ++ "ms)"
    }
}

pub enum Either {
    pub left(value: Any),
    pub right(value: Any),

    pub fn is_left(self) -> bool {
        self matches Either.left(_)
    }

    pub fn is_right(self) -> bool {
        self matches Either.right(_)
    }

    pub fn unwrap_left(self) -> Any {
        self match {
            Either.left(v) => v,
            Either.right(_) => native_panic("Either.unwrap_left called on right"),
        }
    }

    pub fn unwrap_right(self) -> Any {
        self match {
            Either.right(v) => v,
            Either.left(_) => native_panic("Either.unwrap_right called on left"),
        }
    }
}

impl PartialEq for Either {
    pub fn eq(self, other: Self) -> bool {
        self match {
            Either.left(a) => other match {
                Either.left(b) => a == b,
                Either.right(_) => false,
            },
            Either.right(a) => other match {
                Either.right(b) => a == b,
                Either.left(_) => false,
            },
        }
    }
}

impl Display for Either {
    pub fn to_string(self) -> String {
        self match {
            Either.left(v) => "left(" ++ native_to_string(v) ++ ")",
            Either.right(v) => "right(" ++ native_to_string(v) ++ ")",
        }
    }
}

pub use Either.{left, right}

pub fn yield_now() -> Unit {
    native_task_yield()
}

pub fn sleep_ms(ms: i64) -> Unit {
    native_time_sleep_ms(ms)
}

pub fn sleep(dur: Duration) -> Unit {
    native_time_sleep_ms(dur.as_millis())
}

pub fn current_id() -> i64 {
    native_task_current_id()
}

pub fn tree_snapshot() -> String {
    native_task_tree_snapshot()
}

pub fn is_ready(f: Future) -> bool {
    native_task_is_ready(f)
}

pub fn await_all(futures: List) -> List {
    native_task_await_all(futures)
}

pub fn await_any(futures: List) -> Any {
    native_task_await_any(futures)
}

pub fn await_first(first: Future, second: Future) -> Either {
    let pair = List()
    pair.push(first)
    pair.push(second)
    let (idx, value) = native_task_await_indexed(pair)
    if idx == 0 {
        Either.left(value)
    } else {
        Either.right(value)
    }
}

private fn make_timeout_err(ms: i64) -> !TimeoutError Any {
    error TimeoutError.new(ms)
}

pub fn with_timeout(ms: i64, thunk: fn() -> Any) -> Any {
    if ms < 0 {
        let e: Any = make_timeout_err(ms)
        return e
    }
    handles timeout_work() => thunk()
    handles timeout_timer(d: i64) => native_time_sleep_ms(d)
    let pair = List()
    pair.push(timeout_work())
    pair.push(timeout_timer(ms))
    let (idx, value) = native_task_await_indexed(pair)
    if idx == 0 {
        value
    } else {
        let e: Any = make_timeout_err(ms)
        e
    }
}

private fn unwrap_or_error_envelope(val: Any) -> (bool, Any) {
    if native_is_error_value(val) {
        return (true, val)
    }
    (false, native_unwrap_ok_value(val))
}

pub fn par_map(items: List, mapper: fn(Any) -> Any) -> List {
    let snap = items.copy()
    if snap.is_empty() {
        return List()
    }
    handles async par_item_work(item: Any) -> Any => mapper(item)
    let futures = List()
    var i: usize = 0
    while i < snap.len() {
        futures.push(par_item_work(snap.get(i))#)
        i += 1
    }
    let raw_results = native_task_await_all(futures)
    let out = List()
    var j: usize = 0
    while j < raw_results.len() {
        let (is_err, payload) = unwrap_or_error_envelope(raw_results.get(j))
        if is_err {
            return native_forward_error_value(payload)
        }
        out.push(payload)
        j += 1
    }
    out
}

pub fn par_for_each(items: List, action: fn(Any) -> Unit) -> Unit {
    let snap = items.copy()
    if snap.is_empty() {
        return ()
    }
    handles async par_for_each_work(item: Any) -> Any => {
        let f: Any = action
        f(item)
    }
    let futures = List()
    var i: usize = 0
    while i < snap.len() {
        futures.push(par_for_each_work(snap.get(i))#)
        i += 1
    }
    let raw_results = native_task_await_all(futures)
    var j: usize = 0
    while j < raw_results.len() {
        let (is_err, payload) = unwrap_or_error_envelope(raw_results.get(j))
        if is_err {
            return native_forward_error_value(payload)
        }
        j += 1
    }
    ()
}

pub fn race(branches: List) -> Any {
    let snap = branches.copy()
    if snap.is_empty() {
        native_panic("task.race requires at least one branch")
    }
    handles async race_branch_work(branch: Any) -> Any => branch()
    let futures = List()
    var i: usize = 0
    while i < snap.len() {
        let thunk: Any = snap.get(i)
        futures.push(race_branch_work(thunk)#)
        i += 1
    }
    native_task_await_any(futures)
}
