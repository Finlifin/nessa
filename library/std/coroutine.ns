-- std.coroutine — asymmetric stateful coroutines and generators built on delimited continuations.

use .builtin.*
use .collections.*
use .traits.*

private const native_panic: fn(Any) -> NoReturn = .panic'builtin
private const native_to_string: fn(Any) -> String = .to_string'builtin
private const native_task_current_id: fn() -> i64 = .__task_current_id'builtin

private effect co_yield(value: Any, catch k) -> Any

private enum CoOutcome {
    yielded(value: Any, next_cont: Continuation),
    finished(value: Any),
}

private fn format_step_payload(val: Any) -> String {
    val match {
        shown: Display => shown.to_string(),
        _ => native_to_string(val),
    }
}

pub enum CoroutineStep {
    pub yielded(value: Any),
    pub finished(value: Any),

    pub fn is_yielded(self) -> bool = self matches CoroutineStep.yielded(_)

    pub fn is_finished(self) -> bool = self matches CoroutineStep.finished(_)

    pub fn value(self) -> Any {
        self match {
            CoroutineStep.yielded(v) => v,
            CoroutineStep.finished(v) => v,
        }
    }
}

impl Eq for CoroutineStep {
    pub fn eq(self, other: Self) -> bool {
        self match {
            CoroutineStep.yielded(a) => other match {
                CoroutineStep.yielded(b) => a == b,
                CoroutineStep.finished(_) => false,
            },
            CoroutineStep.finished(a) => other match {
                CoroutineStep.finished(b) => a == b,
                CoroutineStep.yielded(_) => false,
            },
        }
    }
}

impl PartialEq for CoroutineStep {
    pub fn eq(self, other: Self) -> bool {
        self match {
            CoroutineStep.yielded(a) => other match {
                CoroutineStep.yielded(b) => a == b,
                CoroutineStep.finished(_) => false,
            },
            CoroutineStep.finished(a) => other match {
                CoroutineStep.finished(b) => a == b,
                CoroutineStep.yielded(_) => false,
            },
        }
    }
}

impl Display for CoroutineStep {
    pub fn to_string(self) -> String {
        self match {
            CoroutineStep.yielded(v) => "CoroutineStep.yielded(" ++ format_step_payload(v) ++ ")",
            CoroutineStep.finished(v) => "CoroutineStep.finished(" ++ format_step_payload(v) ++ ")",
        }
    }
}

pub enum CoroutineStatus {
    pub suspended,
    pub running,
    pub dead,
}
derive Eq, PartialEq, Display for CoroutineStatus

pub enum CoroutineError {
    pub DeadCoroutine,
    pub AlreadyRunning,
    pub UncaughtPanic(message: String),
}
derive Eq, PartialEq for CoroutineError

impl Display for CoroutineError {
    pub fn to_string(self) -> String {
        self match {
            CoroutineError.DeadCoroutine => "cannot step dead coroutine",
            CoroutineError.AlreadyRunning => "cannot step active coroutine",
            CoroutineError.UncaughtPanic(message) => "coroutine panic: " ++ message,
        }
    }
}

private global running_stacks: Map = Map()

private fn current_task_key() -> String = native_to_string(native_task_current_id())

private fn current_running_stack() -> ?List {
    let key = current_task_key()
    if running_stacks.contains(key) {
        running_stacks.get(key).as(List)
    } else {
        null
    }
}

private fn ensure_running_stack() -> List {
    let key = current_task_key()
    if running_stacks.contains(key) {
        running_stacks.get(key).as(List)
    } else {
        let fresh = List()
        running_stacks.set(key, fresh)
        fresh
    }
}

pub struct Coroutine {
    status_field: CoroutineStatus,
    body: Any,
    cont: ?Continuation,
}

impl Coroutine {
    pub fn new(body: fn(Any) -> Any) -> Coroutine {
        Coroutine {
            status_field: CoroutineStatus.suspended,
            body: body,
            cont: null,
        }
    }

    pub fn create(body: fn(Any) -> Any) -> Coroutine = Coroutine.new(body)

    pub fn yield_val(.value: Any = null) -> Any {
        if not is_yieldable() {
            native_panic("attempt to yield from outside a coroutine")
        }
        co_yield(value)#
    }

    pub fn status(self) -> CoroutineStatus = self.status_field

    pub fn is_alive(self) -> bool = self.status_field != CoroutineStatus.dead

    pub fn step(self, .arg: Any = null) -> !CoroutineError CoroutineStep {
        if self.status_field == CoroutineStatus.dead {
            return error CoroutineError.DeadCoroutine
        }
        if self.status_field != CoroutineStatus.suspended {
            return error CoroutineError.AlreadyRunning
        }

        let task_key = current_task_key()
        let running_stack = ensure_running_stack()
        running_stack.push(self)
        self.status_field = CoroutineStatus.running

        defer {
            let _ = running_stack.pop()
            if running_stack.is_empty() {
                let _ = running_stacks.remove(task_key)
            }
            if self.status_field == CoroutineStatus.running {
                self.cont = null
                self.body = null
                self.status_field = CoroutineStatus.dead
            }
        }

        let outcome: CoOutcome = if self.cont == null {
            let entry_fn = self.body
            self.body = null
            (CoOutcome.finished(entry_fn(arg)))# {
                co_yield(val, k) => CoOutcome.yielded(val, k),
            }
        } else {
            let saved = self.cont.as(Continuation)
            self.cont = null
            saved(arg).as(CoOutcome)
        }

        outcome match {
            CoOutcome.yielded(val, next_k) => {
                self.cont = next_k
                self.status_field = CoroutineStatus.suspended
                CoroutineStep.yielded(val)
            },
            CoOutcome.finished(val) => {
                self.cont = null
                self.status_field = CoroutineStatus.dead
                CoroutineStep.finished(val)
            },
        }
    }

    pub fn try_resume(self, .arg: Any = null) -> !CoroutineError Any {
        let s = self.step(arg = arg)!
        s.value()
    }

    pub fn close(self) -> bool {
        if self.status_field != CoroutineStatus.suspended {
            return false
        }
        self.cont = null
        self.body = null
        self.status_field = CoroutineStatus.dead
        true
    }

    pub fn generator(body: fn() -> Any) -> GeneratorIter {
        let co = Coroutine.new(|_: Any| -> Any {
            body()
        })
        GeneratorIter { co: co }
    }
}

pub fn create(body: fn(Any) -> Any) -> Coroutine = Coroutine.new(body)

pub fn step(co: Coroutine, .arg: Any = null) -> !CoroutineError CoroutineStep = co.step(arg = arg)

pub fn try_resume(co: Coroutine, .arg: Any = null) -> !CoroutineError Any = co.try_resume(arg = arg)

pub fn running() -> ?Coroutine {
    current_running_stack() match {
        stack? => if stack.is_empty() { null } else { stack.last().as(Coroutine) },
        null => null,
    }
}

pub fn is_yieldable() -> bool {
    current_running_stack() match {
        stack? => not stack.is_empty(),
        null => false,
    }
}

pub fn yield_val(.value: Any = null) -> Any {
    if not is_yieldable() {
        native_panic("attempt to yield from outside a coroutine")
    }
    co_yield(value)#
}

pub struct GeneratorIter {
    co: Coroutine,
}

impl Iterator for GeneratorIter {
    assoc Item: Type = Any
    pub fn next(self) -> IterationStep(Any) {
        if not self.co.is_alive() {
            return IterationStep(Any).done
        }
        self.co.step() match {
            CoroutineStep.yielded(val)! => IterationStep(Any).yielded(val),
            CoroutineStep.finished(_)! => IterationStep(Any).done,
            error err => native_panic(err.to_string()),
        }
    }
}

impl IntoIterator for GeneratorIter {
    assoc Iter: Type = GeneratorIter
    pub fn into_iter(self) -> GeneratorIter = self
}

pub fn generator(body: fn() -> Any) -> GeneratorIter = Coroutine.generator(body)
