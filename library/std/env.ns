-- std.env — process arguments, environment variables, working directory, and host info.

use .builtin.*
use .io.{IoError, io_error_from_code}
use .path.{Path, to_path_string}

private const native_env_args: fn() -> List = .__env_args'builtin
private const native_env_get: fn(String) -> ?String = .__env_get'builtin
private const native_env_vars: fn() -> Map = .__env_vars'builtin
private const native_env_current_dir: fn() -> (i64, String) = .__env_current_dir'builtin
private const native_env_set_current_dir: fn(String) -> (i64, String) = .__env_set_current_dir'builtin
private const native_env_os: fn() -> String = .__env_os'builtin
private const native_env_arch: fn() -> String = .__env_arch'builtin

pub fn args() -> List = native_env_args()

pub fn get(key: String) -> ?String = native_env_get(key)

pub fn get_or(key: String, default: String) -> String {
    native_env_get(key) match {
        val? => val,
        _ => default,
    }
}

pub fn vars() -> Map = native_env_vars()

pub fn current_dir() -> !IoError String {
    let (code, dir_or_msg) = native_env_current_dir()
    if code == 0 { dir_or_msg } else { error io_error_from_code(code, dir_or_msg) }
}

pub fn current_dir_path() -> !IoError Path {
    Path.new(current_dir()!)
}

pub fn set_current_dir(path: Any) -> !IoError Unit {
    let (code, msg) = native_env_set_current_dir(to_path_string(path))
    if code == 0 { () } else { error io_error_from_code(code, msg) }
}

pub fn os() -> String = native_env_os()
pub fn arch() -> String = native_env_arch()
