-- std.env — process arguments, environment variables, working directory, and host info.

use .builtin.*
use .io.{IoError, io_error_from_code}

private const _env_args: fn() -> List = .__env_args'builtin
private const _env_get: fn(String) -> ?String = .__env_get'builtin
private const _env_vars: fn() -> Map = .__env_vars'builtin
private const _env_current_dir: fn() -> (i64, String) = .__env_current_dir'builtin
private const _env_set_current_dir: fn(String) -> (i64, String) = .__env_set_current_dir'builtin
private const _env_os: fn() -> String = .__env_os'builtin
private const _env_arch: fn() -> String = .__env_arch'builtin

pub fn args() -> List = _env_args()

pub fn get(key: String) -> ?String = _env_get(key)

pub fn get_or(key: String, default: String) -> String {
    _env_get(key) match {
        val? => val,
        _ => default,
    }
}

pub fn vars() -> Map = _env_vars()

pub fn current_dir() -> !IoError String {
    let (code, dir_or_msg) = _env_current_dir()
    if code == 0 { dir_or_msg } else { error io_error_from_code(code, dir_or_msg) }
}

pub fn set_current_dir(path: String) -> !IoError Unit {
    let (code, msg) = _env_set_current_dir(path)
    if code == 0 { () } else { error io_error_from_code(code, msg) }
}

pub fn os() -> String = _env_os()
pub fn arch() -> String = _env_arch()
