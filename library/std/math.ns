pub const f64_max: fn() -> f64 = .f64_max'builtin
pub const golden_ratio: fn() -> f64 = .golden_ratio'builtin
pub const euler_gamma: fn() -> f64 = .euler_gamma'builtin
pub const classify: fn(f64) -> String = .f64_classify'builtin
const native_classify: fn(f64) -> String = .f64_classify'builtin
const native_trunc_i64: fn(f64) -> Any = .trunc_i64'builtin
const native_trunc_u64: fn(f64) -> Any = .trunc_u64'builtin
const native_trunc_i128: fn(f64) -> Any = .trunc_i128'builtin
const native_trunc_u128: fn(f64) -> Any = .trunc_u128'builtin

-- Truncate toward zero. A non-finite value, or one that does not fit, is null.
pub fn trunc_i64(value: f64) -> ?i64 {
    let truncated = native_trunc_i64(value)
    if truncated == null { null } else { truncated.as(i64) }
}
pub fn trunc_u64(value: f64) -> ?u64 {
    let truncated = native_trunc_u64(value)
    if truncated == null { null } else { truncated.as(u64) }
}
pub fn trunc_i128(value: f64) -> ?i128 {
    let truncated = native_trunc_i128(value)
    if truncated == null { null } else { truncated.as(i128) }
}
pub fn trunc_u128(value: f64) -> ?u128 {
    let truncated = native_trunc_u128(value)
    if truncated == null { null } else { truncated.as(u128) }
}

const native_from_bits: fn(u64) -> f64 = .from_bits'builtin
-- Interpret the IEEE-754 bits of an unsigned 64-bit integer.
pub fn f64_from_bits(bits: u64) -> f64 { native_from_bits(bits) }

const native_f64_to_fixed: fn(f64, i64) -> String = .f64_to_fixed'builtin
const native_f64_to_exp: fn(f64, i64) -> String = .f64_to_exp'builtin
const native_f64_to_precision: fn(f64, i64) -> String = .f64_to_precision'builtin
pub const frexp: fn(f64) -> (f64, i64) = .f64_frexp'builtin
const native_frexp: fn(f64) -> (f64, i64) = .f64_frexp'builtin
pub const ldexp: fn(f64, i64) -> f64 = .f64_ldexp'builtin
const native_ldexp: fn(f64, i64) -> f64 = .f64_ldexp'builtin

private fn approx_eq_impl(a: f64, b: f64, rel_tol: f64, abs_tol: f64) -> bool {
    if native_is_nan(a) or native_is_nan(b) {
        return false
    }
    if a == b {
        return true
    }
    if native_is_infinite(a) or native_is_infinite(b) {
        return false
    }
    let diff = native_f64_abs_diff(a, b)
    let mag_a = native_abs(a).as(f64)
    let mag_b = native_abs(b).as(f64)
    let max_mag = if mag_a > mag_b { mag_a } else { mag_b }
    let rel_bound = rel_tol * max_mag
    let bound = if rel_bound > abs_tol { rel_bound } else { abs_tol }
    diff <= bound
}

-- Relative and absolute floating-point closeness check (`|a - b| <= max(rel_tol * max(|a|, |b|), abs_tol)`).
pub fn approx_eq(a: f64, b: f64, .rel_tol: f64 = 1.0e-9, .abs_tol: f64 = 0.0) -> bool {
    approx_eq_impl(a, b, rel_tol, abs_tol)
}

private fn lerp_impl(a: f64, b: f64, t: f64) -> f64 {
    if (a <= 0.0 and b >= 0.0) or (a >= 0.0 and b <= 0.0) {
        return t * b + (1.0 - t) * a
    }
    if t == 1.0 {
        return b
    }
    let x = a + t * (b - a)
    if (t > 1.0) == (b > a) {
        if b > x { b } else { x }
    } else {
        if b < x { b } else { x }
    }
}

-- Endpoint-exact monotonic linear interpolation between `a` (`t = 0.0`) and `b` (`t = 1.0`).
pub fn lerp(a: f64, b: f64, t: f64) -> f64 = lerp_impl(a, b, t)

private fn split_fract_impl(x: f64) -> (f64, f64) {
    if native_is_nan(x) {
        return (x, x)
    }
    if native_is_infinite(x) {
        return (x, native_copysign(0.0, x))
    }
    let int_part = native_trunc(x)
    (int_part, native_copysign(x - int_part, x))
}

-- Split `x` into `(integral, fractional)` parts with matching IEEE-754 sign.
pub fn split_fract(x: f64) -> (f64, f64) = split_fract_impl(x)

impl f64 {
    -- Call the private bindings. The public functions share these names, and a
    -- direct call would resolve to the method itself.
    pub fn is_nan(self) -> bool { native_is_nan(self) }
    pub fn is_infinite(self) -> bool { native_is_infinite(self) }
    pub fn is_finite(self) -> bool { native_is_finite(self) }
    pub fn is_sign_negative(self) -> bool { native_is_sign_negative(self) }
    pub fn is_sign_positive(self) -> bool { native_is_sign_positive(self) }
    pub fn abs(self) -> f64 { native_abs(self).as(f64) }
    pub fn sign(self) -> ?i64 { native_sign(self) }
    pub fn floor(self) -> f64 { native_floor(self) }
    pub fn ceil(self) -> f64 { native_ceil(self) }
    pub fn round(self) -> f64 { native_round(self) }
    pub fn trunc(self) -> f64 { native_trunc(self) }
    pub fn fract(self) -> f64 { native_fract(self) }
    pub fn sqrt(self) -> f64 { native_sqrt(self) }
    pub fn signum(self) -> f64 { native_signum(self) }
    pub fn recip(self) -> f64 { native_recip(self) }
    pub fn mul_add(self, factor: f64, addend: f64) -> f64 { native_mul_add(self, factor, addend) }
    pub fn div_euclid(self, divisor: f64) -> f64 { native_div_euclid(self, divisor) }
    pub fn rem_euclid(self, divisor: f64) -> f64 { native_rem_euclid(self, divisor) }
    pub fn to_radians(self) -> f64 { native_to_radians(self) }
    pub fn to_degrees(self) -> f64 { native_to_degrees(self) }
    pub fn next_up(self) -> f64 { native_next_up(self) }
    pub fn next_down(self) -> f64 { native_next_down(self) }
    pub fn midpoint(self, other: f64) -> f64 { native_midpoint(self, other) }
    pub fn round_ties_even(self) -> f64 { native_round_ties_even(self) }
    pub fn asinh(self) -> f64 { native_asinh(self) }
    pub fn acosh(self) -> f64 { native_acosh(self) }
    pub fn atanh(self) -> f64 { native_atanh(self) }
    pub fn is_normal(self) -> bool { native_is_normal(self) }
    pub fn is_subnormal(self) -> bool { native_is_subnormal(self) }
    -- `nan`, `infinite`, `zero`, `subnormal`, or `normal`. Both zeros are `zero`.
    pub fn classify(self) -> String { native_classify(self) }
    pub fn to_bits(self) -> u64 { native_to_bits(self).as(u64) }
    pub fn powi(self, exponent: i64) -> f64 { native_powi(self, exponent) }
    pub fn log_base(self, base: f64) -> f64 { native_log_base(self, base) }
    pub fn trunc_i64(self) -> ?i64 {
        let truncated = native_trunc_i64(self)
        if truncated == null { null } else { truncated.as(i64) }
    }
    pub fn trunc_u64(self) -> ?u64 {
        let truncated = native_trunc_u64(self)
        if truncated == null { null } else { truncated.as(u64) }
    }
    pub fn trunc_i128(self) -> ?i128 {
        let truncated = native_trunc_i128(self)
        if truncated == null { null } else { truncated.as(i128) }
    }
    pub fn trunc_u128(self) -> ?u128 {
        let truncated = native_trunc_u128(self)
        if truncated == null { null } else { truncated.as(u128) }
    }
    pub fn total_cmp(self, other: f64) -> i64 { native_total_cmp(self, other) }
    pub fn to_be_bytes(self) -> List { native_f64_to_be_bytes(self) }
    pub fn to_le_bytes(self) -> List { native_f64_to_le_bytes(self) }
    pub fn to_ne_bytes(self) -> List { native_f64_to_ne_bytes(self) }
    pub fn copysign(self, sign: f64) -> f64 { native_copysign(self, sign) }
    pub fn algebraic_add(self, other: f64) -> f64 { native_algebraic_add(self, other) }
    pub fn algebraic_sub(self, other: f64) -> f64 { native_algebraic_sub(self, other) }
    pub fn algebraic_mul(self, other: f64) -> f64 { native_algebraic_mul(self, other) }
    pub fn algebraic_div(self, other: f64) -> f64 { native_algebraic_div(self, other) }
    pub fn algebraic_rem(self, other: f64) -> f64 { native_algebraic_rem(self, other) }
    -- A NaN becomes `replacement`. Infinities stay themselves.
    pub fn nan_to(self, replacement: f64) -> f64 { native_nan_to(self, replacement) }
    pub fn abs_diff(self, other: f64) -> f64 { native_f64_abs_diff(self, other) }
    -- True for both +0.0 and -0.0.
    pub fn is_zero(self) -> bool { native_f64_is_zero(self) }
    pub fn frexp(self) -> (f64, i64) { native_frexp(self) }
    pub fn ldexp(self, exponent: i64) -> f64 { native_ldexp(self, exponent) }
    pub fn to_fixed(self, digits: i64) -> String { native_f64_to_fixed(self, digits) }
    pub fn to_exp(self, .digits: i64 = -1) -> String { native_f64_to_exp(self, digits) }
    pub fn to_precision(self, digits: i64) -> String { native_f64_to_precision(self, digits) }
    pub fn approx_eq(self, other: f64, .rel_tol: f64 = 1.0e-9, .abs_tol: f64 = 0.0) -> bool {
        approx_eq_impl(self, other, rel_tol, abs_tol)
    }
    pub fn lerp(self, other: f64, t: f64) -> f64 {
        lerp_impl(self, other, t)
    }
    pub fn split_fract(self) -> (f64, f64) {
        split_fract_impl(self)
    }
}
