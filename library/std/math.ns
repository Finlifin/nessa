-- Exact IEEE-754 constants (zero-arg builtins so prelude imports require no runtime startup).
pub const PI: fn() -> f64 = .pi'builtin
pub const TAU: fn() -> f64 = .tau'builtin
pub const E: fn() -> f64 = .euler'builtin
pub const INFINITY: fn() -> f64 = .infinity'builtin
pub const NEG_INFINITY: fn() -> f64 = .neg_infinity'builtin
pub const NAN: fn() -> f64 = .nan'builtin

pub const pi: fn() -> f64 = .pi'builtin
pub const euler: fn() -> f64 = .euler'builtin
pub const tau: fn() -> f64 = .tau'builtin
pub const ln_2: fn() -> f64 = .ln_2'builtin
pub const ln_10: fn() -> f64 = .ln_10'builtin
pub const log2_e: fn() -> f64 = .log2_e'builtin
pub const log10_e: fn() -> f64 = .log10_e'builtin
pub const sqrt_2: fn() -> f64 = .sqrt_2'builtin
pub const infinity: fn() -> f64 = .infinity'builtin
pub const neg_infinity: fn() -> f64 = .neg_infinity'builtin
pub const nan: fn() -> f64 = .nan'builtin
pub const epsilon: fn() -> f64 = .epsilon'builtin
