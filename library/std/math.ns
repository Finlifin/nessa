pub const atan2: fn(f64, f64) -> f64 = .atan2'builtin
pub const hypot: fn(f64, f64) -> f64 = .hypot'builtin
-- Classification reads the IEEE value. `is_sign_negative` is the sign bit, so
-- negative zero and a negative NaN are true. `sign` still treats negative zero as zero.
