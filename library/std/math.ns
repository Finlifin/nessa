-- std.math — IEEE-754 floating-point constants, elementary functions, and numeric utilities.

use .builtin.*
use .traits.*

pub const abs: fn(Any) -> Any = .abs'builtin
const native_abs: fn(Any) -> Any = .abs'builtin
pub const sin: fn(f64) -> f64 = .sin'builtin
pub const cos: fn(f64) -> f64 = .cos'builtin
pub const sqrt: fn(f64) -> f64 = .sqrt'builtin
const native_sqrt: fn(f64) -> f64 = .sqrt'builtin
pub const floor: fn(f64) -> f64 = .floor'builtin
const native_floor: fn(f64) -> f64 = .floor'builtin
pub const ceil: fn(f64) -> f64 = .ceil'builtin
const native_ceil: fn(f64) -> f64 = .ceil'builtin
pub const round: fn(f64) -> f64 = .round'builtin
const native_round: fn(f64) -> f64 = .round'builtin
-- Numeric native dispatch preserves integral powers; generic numeric signatures are pending.
pub const pow: fn(Any, Any) -> Any = .pow'builtin
pub const log: fn(f64) -> f64 = .log'builtin
-- The result keeps one operand's numeric kind. Ties and unordered pairs (NaN)
-- keep the left operand, so `min(1, 1.0)` is an i64 and `min(1.0, 1)` is an f64.
pub const min: fn(Any, Any) -> Any = .min'builtin
pub const max: fn(Any, Any) -> Any = .max'builtin
-- Bounds are inclusive. A lower bound greater than the upper bound is a runtime error.
pub const clamp: fn(Any, Any, Any) -> Any = .clamp'builtin
-- `-1`, `0`, or `1`. NaN is null. Negative zero compares equal to zero.
pub const sign: fn(Any) -> ?i64 = .sign'builtin
const native_sign: fn(Any) -> ?i64 = .sign'builtin
-- IEEE results, including infinity and NaN. Domain errors are NaN, not a runtime error.
pub const exp: fn(f64) -> f64 = .exp'builtin
pub const log2: fn(f64) -> f64 = .log2'builtin
pub const log10: fn(f64) -> f64 = .log10'builtin
pub const trunc: fn(f64) -> f64 = .trunc'builtin
const native_trunc: fn(f64) -> f64 = .trunc'builtin
pub const fract: fn(f64) -> f64 = .fract'builtin
const native_fract: fn(f64) -> f64 = .fract'builtin
pub const tan: fn(f64) -> f64 = .tan'builtin
pub const asin: fn(f64) -> f64 = .asin'builtin
pub const acos: fn(f64) -> f64 = .acos'builtin
pub const atan: fn(f64) -> f64 = .atan'builtin
-- Magnitude from the first argument, sign bit from the second, including -0.0.
pub const copysign: fn(f64, f64) -> f64 = .copysign'builtin
const native_copysign: fn(f64, f64) -> f64 = .copysign'builtin
-- `atan2(y, x)` is the angle of the vector `(x, y)`.
pub const atan2: fn(f64, f64) -> f64 = .atan2'builtin
pub const hypot: fn(f64, f64) -> f64 = .hypot'builtin
-- Classification reads the IEEE value. `is_sign_negative` is the sign bit, so
-- negative zero and a negative NaN are true. `sign` still treats negative zero as zero.
pub const is_nan: fn(f64) -> bool = .is_nan'builtin
const native_is_nan: fn(f64) -> bool = .is_nan'builtin
pub const is_infinite: fn(f64) -> bool = .is_infinite'builtin
const native_is_infinite: fn(f64) -> bool = .is_infinite'builtin
pub const is_finite: fn(f64) -> bool = .is_finite'builtin
const native_is_finite: fn(f64) -> bool = .is_finite'builtin
pub const is_sign_negative: fn(f64) -> bool = .is_sign_negative'builtin
const native_is_sign_negative: fn(f64) -> bool = .is_sign_negative'builtin
pub const is_sign_positive: fn(f64) -> bool = .is_sign_positive'builtin
const native_is_sign_positive: fn(f64) -> bool = .is_sign_positive'builtin
pub const sinh: fn(f64) -> f64 = .sinh'builtin
pub const cosh: fn(f64) -> f64 = .cosh'builtin
pub const tanh: fn(f64) -> f64 = .tanh'builtin
pub const cbrt: fn(f64) -> f64 = .cbrt'builtin
pub const exp2: fn(f64) -> f64 = .exp2'builtin
pub const expm1: fn(f64) -> f64 = .expm1'builtin
pub const log1p: fn(f64) -> f64 = .log1p'builtin
-- `signum` is `1.0` or `-1.0`, including the sign of zero. NaN stays NaN.
-- `recip(0)` is infinity, not a runtime error. `mul_add(a, b, c)` is `a * b + c`.
-- Euclidean division rounds toward negative infinity.
