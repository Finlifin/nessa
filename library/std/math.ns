const native_trunc_u128: fn(f64) -> Any = .trunc_u128'builtin
-- Truncate toward zero. A non-finite value, or one that does not fit, is null.
pub fn trunc_i64(value: f64) -> ?i64 {
    let truncated = native_trunc_i64(value)
    if truncated == null { null } else { truncated.as(i64) }
}
pub fn trunc_u64(value: f64) -> ?u64 {
    let truncated = native_trunc_u64(value)
    if truncated == null { null } else { truncated.as(u64) }
}
pub fn trunc_i128(value: f64) -> ?i128 {
    let truncated = native_trunc_i128(value)
    if truncated == null { null } else { truncated.as(i128) }
}
pub fn trunc_u128(value: f64) -> ?u128 {
    let truncated = native_trunc_u128(value)
    if truncated == null { null } else { truncated.as(u128) }
}
const native_from_bits: fn(u64) -> f64 = .from_bits'builtin
-- Interpret the IEEE-754 bits of an unsigned 64-bit integer.
pub fn f64_from_bits(bits: u64) -> f64 { native_from_bits(bits) }

const native_f64_to_fixed: fn(f64, i64) -> String = .f64_to_fixed'builtin
const native_f64_to_exp: fn(f64, i64) -> String = .f64_to_exp'builtin
const native_f64_to_precision: fn(f64, i64) -> String = .f64_to_precision'builtin
