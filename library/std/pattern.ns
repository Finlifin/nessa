-- std.pattern — compact byte/UTF-8 pattern matching, captures, lazy iteration, and replacement.

use .builtin.*
use .collections.*
use .traits.*

const native_pat_find: fn(String, String, i64, bool) -> (i64, i64, List, String) = .__pat_find'builtin
const native_pat_gsub: fn(String, String, String, i64) -> (String, i64, String) = .__pat_gsub'builtin
const native_str_len: fn(String) -> i64 = .str_len'builtin
const native_str_get: fn(String, i64, i64) -> Any = .str_get'builtin
const native_str_bytes: fn(String) -> List = .str_bytes'builtin
const native_from_utf8_lossy: fn(List) -> String = .str_from_utf8_lossy'builtin
const native_char_at_byte: fn(String, i64) -> ?char = .str_char_at_byte'builtin
const native_char_utf8_len: fn(char) -> i64 = .char_utf8_len'builtin
const native_starts_with: fn(String, String) -> bool = .str_starts_with'builtin
const native_chars: fn(String) -> List = .str_chars'builtin
const native_into_string: fn(char) -> String = .char_into_string'builtin
const native_panic: fn(Any) -> NoReturn = .panic'builtin
const native_is_error_value: fn(Any) -> bool = .__is_error_value'builtin
const native_unwrap_ok_value: fn(Any) -> Any = .__unwrap_ok_value'builtin
const native_forward_error_value: fn(Any) -> NoReturn = .__forward_error_value'builtin

pub enum PatternError {
    pub InvalidPattern(message: String),
}

derive Eq, PartialEq for PatternError

impl Display for PatternError {
    pub fn to_string(self) -> String {
        self match {
            PatternError.InvalidPattern(message) => "invalid pattern: " ++ message,
        }
    }
}

pub struct PatternMatch {
    pub start: usize,
    pub end: usize,
    pub captures: List,
}

impl PatternMatch {
    pub fn len(self) -> usize = self.end - self.start

    pub fn is_empty(self) -> bool = self.start == self.end

    pub fn slice_of(self, text: String) -> String {
        slice_bytes_lossy(text, self.start.as(i64), self.end.as(i64))
    }
}

impl PartialEq for PatternMatch {
    pub fn eq(self, other: Self) -> bool {
        self.start == other.start
            and self.end == other.end
            and self.captures == other.captures
    }
}

impl Display for PatternMatch {
    pub fn to_string(self) -> String {
        "PatternMatch(" ++ self.start.to_string() ++ ".." ++ self.end.to_string() ++ ")"
    }
}

fn slice_bytes_lossy(text: String, start: i64, end_byte: i64) -> String {
    if start >= end_byte {
        return ""
    }
    let direct = native_str_get(text, start, end_byte)
    if direct != null {
        return direct.as(String)
    }
    let raw = native_str_bytes(text)
    let sub = List()
    var idx = start
    while idx < end_byte and idx < raw.len() {
        sub.push(raw.get(idx.as(usize)))
        idx += 1
    }
    native_from_utf8_lossy(sub)
}

fn next_search_byte(text: String, pos: i64, text_len: i64) -> i64 {
    if pos >= text_len {
        return text_len + 1
    }
    native_char_at_byte(text, pos) match {
        ch? => pos + native_char_utf8_len(ch),
        _ => pos + 1,
    }
}

-- Find the first match of `pat` in `text` starting at 0-based byte offset `start`.
-- When `plain` is true, pattern metacharacters are matched literally.
pub fn find(text: String, pat: String, .start: usize = 0, .plain: bool = false) -> !PatternError ?PatternMatch {
    let (m_start, m_end, cap_list, err_msg) = native_pat_find(text, pat, start.as(i64), plain)
    if err_msg != "" {
        return error PatternError.InvalidPattern(err_msg)
    }
    if m_start < 0 {
        return null
    }
    PatternMatch {
        start: m_start.as(usize),
        end: m_end.as(usize),
        captures: cap_list,
    }
}

-- Return `true` when `pat` matches `text` at or after 0-based byte offset `start`.
pub fn is_match(text: String, pat: String, .start: usize = 0) -> !PatternError bool {
    let found = find(text, pat, start = start)!
    found != null
}

pub struct PatternIter {
    text: String,
    pat: String,
    text_len: i64,
    pos: i64,
    last_match_end: i64,
    anchored: bool,
    finished: bool,
}

impl Iterator for PatternIter {
    assoc Item: Type = PatternMatch

    pub fn next(self) -> IterationStep(PatternMatch) {
        while (not self.finished) and self.pos <= self.text_len {
            let (m_start, m_end, cap_list, err_msg) = native_pat_find(self.text, self.pat, self.pos, false)
            if err_msg != "" {
                self.finished = true
                native_panic("invalid pattern: " ++ err_msg)
            }
            if m_start < 0 {
                self.finished = true
                return IterationStep(PatternMatch).done
            }
            if m_start == m_end and m_end == self.last_match_end {
                if self.anchored or self.pos >= self.text_len {
                    self.finished = true
                    return IterationStep(PatternMatch).done
                }
                self.pos = next_search_byte(self.text, self.pos, self.text_len)
            } else {
                let item = PatternMatch {
                    start: m_start.as(usize),
                    end: m_end.as(usize),
                    captures: cap_list,
                }
                self.last_match_end = m_end
                if self.anchored {
                    self.finished = true
                } else if m_start == m_end {
                    if m_end >= self.text_len {
                        self.finished = true
                    } else {
                        self.pos = next_search_byte(self.text, m_end, self.text_len)
                    }
                } else {
                    self.pos = m_end
                }
                return IterationStep(PatternMatch).yielded(item)
            }
        }
        self.finished = true
        IterationStep(PatternMatch).done
    }
}

impl IntoIterator for PatternIter {
    assoc Iter: Type = PatternIter

    pub fn into_iter(self) -> PatternIter {
        self
    }
}

-- Validate `pat` and return a lazy iterator over all non-overlapping `PatternMatch` spans in `text`.
pub fn find_iter(text: String, pat: String) -> !PatternError PatternIter {
    let (_, _, _, err_msg) = native_pat_find("", pat, 0, false)
    if err_msg != "" {
        return error PatternError.InvalidPattern(err_msg)
    }
    PatternIter {
        text: text,
        pat: pat,
        text_len: native_str_len(text),
        pos: 0,
        last_match_end: -1,
        anchored: native_starts_with(pat, "^"),
        finished: false,
    }
}

-- Collect all non-overlapping `PatternMatch` items of `pat` in `text`.
pub fn find_all(text: String, pat: String) -> !PatternError List {
    let it = find_iter(text, pat)!
    let out = List()
    while true {
        it.next() match {
            IterationStep(PatternMatch).done => { return out },
            IterationStep(PatternMatch).yielded(item) => { out.push(item) },
        }
    }
    out
}

-- Replace matches of `pat` using a capture template (`%0`, `%1`..`%9`, `%%`),
-- returning `(replaced_text, replacement_count)`.
pub fn replace(text: String, pat: String, repl: String, .limit: ?usize = null) -> !PatternError (String, usize) {
    let raw_limit: i64 = limit match {
        lim? => {
            if lim == 0 {
                let (_, _, _, init_err) = native_pat_find("", pat, 0, false)
                if init_err != "" {
                    return error PatternError.InvalidPattern(init_err)
                }
                let zero_u: usize = 0
                return (text, zero_u)
            }
            lim.as(i64)
        },
        _ => -1,
    }
    let (out, count, err_msg) = native_pat_gsub(text, pat, repl, raw_limit)
    if err_msg != "" {
        return error PatternError.InvalidPattern(err_msg)
    }
    (out, count.as(usize))
}

-- Replace matches of `pat` by calling `repl(match_item)`, returning `(replaced_text, replacement_count)`.
pub fn replace_with(
    text: String,
    pat: String,
    repl: fn(PatternMatch) -> String,
    .limit: ?usize = null
) -> !PatternError (String, usize) {
    let (_, _, _, init_err) = native_pat_find("", pat, 0, false)
    if init_err != "" {
        return error PatternError.InvalidPattern(init_err)
    }
    let has_limit = limit != null
    let max_count: usize = if has_limit { limit.as(usize) } else { 0 }
    if has_limit and max_count == 0 {
        let zero_u: usize = 0
        return (text, zero_u)
    }

    let text_len = native_str_len(text)
    let anchored = native_starts_with(pat, "^")
    let pieces = List()
    var search_pos: i64 = 0
    var copy_from: i64 = 0
    var last_match_end: i64 = -1
    var count: usize = 0

    while search_pos <= text_len {
        if has_limit and count >= max_count {
            break
        }
        let (m_start, m_end, cap_list, err_msg) = native_pat_find(text, pat, search_pos, false)
        if err_msg != "" {
            return error PatternError.InvalidPattern(err_msg)
        }
        if m_start < 0 {
            break
        }
        if m_start == m_end and m_end == last_match_end {
            if anchored or search_pos >= text_len {
                break
            }
            search_pos = next_search_byte(text, search_pos, text_len)
        } else {
            if m_start > copy_from {
                pieces.push(slice_bytes_lossy(text, copy_from, m_start))
            }
            let item = PatternMatch {
                start: m_start.as(usize),
                end: m_end.as(usize),
                captures: cap_list,
            }
            let cb: Any = repl
            let replaced = cb(item)
            if native_is_error_value(replaced) {
                return native_forward_error_value(replaced)
            }
            pieces.push(native_unwrap_ok_value(replaced).as(String))
            count += 1
            copy_from = m_end
            last_match_end = m_end
            if anchored {
                break
            }
            if m_start == m_end {
                if m_end >= text_len {
                    break
                }
                search_pos = next_search_byte(text, m_end, text_len)
            } else {
                search_pos = m_end
            }
        }
    }

    if copy_from < text_len {
        pieces.push(slice_bytes_lossy(text, copy_from, text_len))
    }
    (pieces.join(""), count)
}

fn is_pattern_magic(ch: char) -> bool {
    ch == '^'
        or ch == '$'
        or ch == '('
        or ch == ')'
        or ch == '%'
        or ch == '.'
        or ch == '['
        or ch == ']'
        or ch == '*'
        or ch == '+'
        or ch == '-'
        or ch == '?'
}

-- Escape all pattern magic characters (`^$()%.[]*+-?`) with `%`.
pub fn escape(text: String) -> String {
    let chars = native_chars(text)
    let pieces = List()
    var idx: usize = 0
    while idx < chars.len() {
        let ch = chars.get(idx).as(char)
        if is_pattern_magic(ch) {
            pieces.push("%")
        }
        pieces.push(native_into_string(ch))
        idx += 1
    }
    pieces.join("")
}
