const native_char_from_code_u8: fn(i64) -> ?char = .char_from_code'builtin
const native_f32_is_nan: fn(f64) -> bool = .is_nan'builtin
const native_f32_is_infinite: fn(f64) -> bool = .is_infinite'builtin
const native_f32_is_finite: fn(f64) -> bool = .is_finite'builtin
const native_f32_is_zero: fn(f64) -> bool = .f64_is_zero'builtin
const native_f32_is_sign_positive: fn(f64) -> bool = .is_sign_positive'builtin
const native_f32_is_sign_negative: fn(f64) -> bool = .is_sign_negative'builtin
const native_f32_abs: fn(Any) -> Any = .abs'builtin
const native_f32_floor: fn(f64) -> f64 = .floor'builtin
const native_f32_ceil: fn(f64) -> f64 = .ceil'builtin
const native_f32_round: fn(f64) -> f64 = .round'builtin
const native_f32_trunc: fn(f64) -> f64 = .trunc'builtin
const native_f32_fract: fn(f64) -> f64 = .fract'builtin
const native_f32_sqrt: fn(f64) -> f64 = .sqrt'builtin

fn f32_min_positive_f64() -> f64 {
    let bits: u64 = 0x3810000000000000
    native_from_bits(bits)
}

impl i8 {
    pub fn bits() -> i64 = 8
    pub fn min_value() -> i8 = (-128).as(i8)
    pub fn max_value() -> i8 = (127).as(i8)
    pub fn is_zero(self) -> bool { self.as(i64) == 0 }
    pub fn is_positive(self) -> bool { self.as(i64) > 0 }
    pub fn is_negative(self) -> bool { self.as(i64) < 0 }
    pub fn signum(self) -> i8 {
        let v = self.as(i64)
        (if v < 0 { -1 } else if v > 0 { 1 } else { 0 }).as(i8)
    }
    pub fn checked_abs(self) -> ?i8 {
        let v = self.as(i64)
        if v == -128 { null } else if v < 0 { (-v).as(i8) } else { self }
    }
    pub fn wrapping_abs(self) -> i8 {
        let v = self.as(i64)
        if v == -128 { self } else if v < 0 { (-v).as(i8) } else { self }
    }
    pub fn saturating_abs(self) -> i8 {
        let v = self.as(i64)
        if v == -128 { (127).as(i8) } else if v < 0 { (-v).as(i8) } else { self }
    }
}

