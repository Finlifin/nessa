    pub fn bits() -> i64 = 32
    pub fn min_value() -> u32 = (0).as(u32)
    pub fn max_value() -> u32 = (4294967295).as(u32)
    pub fn is_zero(self) -> bool { self.as(i64) == 0 }
}

impl f32 {
    pub fn is_nan(self) -> bool { native_f32_is_nan(self.as(f64)) }
    pub fn is_infinite(self) -> bool { native_f32_is_infinite(self.as(f64)) }
    pub fn is_finite(self) -> bool { native_f32_is_finite(self.as(f64)) }
    pub fn is_zero(self) -> bool { native_f32_is_zero(self.as(f64)) }
    pub fn is_normal(self) -> bool {
        let v = self.as(f64)
        native_f32_is_finite(v)
            and (not native_f32_is_zero(v))
            and native_f32_abs(v).as(f64) >= f32_min_positive_f64()
    }
    pub fn is_subnormal(self) -> bool {
        let v = self.as(f64)
        native_f32_is_finite(v)
            and (not native_f32_is_zero(v))
            and native_f32_abs(v).as(f64) < f32_min_positive_f64()
    }
    pub fn is_sign_positive(self) -> bool { native_f32_is_sign_positive(self.as(f64)) }
    pub fn is_sign_negative(self) -> bool { native_f32_is_sign_negative(self.as(f64)) }
    pub fn abs(self) -> f32 { native_f32_abs(self.as(f64)).as(f32) }
    pub fn floor(self) -> f32 { native_f32_floor(self.as(f64)).as(f32) }
    pub fn ceil(self) -> f32 { native_f32_ceil(self.as(f64)).as(f32) }
    pub fn round(self) -> f32 { native_f32_round(self.as(f64)).as(f32) }
    pub fn trunc(self) -> f32 { native_f32_trunc(self.as(f64)).as(f32) }
    pub fn fract(self) -> f32 { native_f32_fract(self.as(f64)).as(f32) }
    pub fn sqrt(self) -> f32 { native_f32_sqrt(self.as(f64)).as(f32) }
}
