    pub fn max_value() -> u8 = (255).as(u8)
    pub fn is_zero(self) -> bool { self.as(i64) == 0 }
    pub fn is_ascii(self) -> bool { self.as(i64) <= 127 }
    pub fn to_char(self) -> char { native_char_from_code_u8(self.as(i64)).as(char) }
}

