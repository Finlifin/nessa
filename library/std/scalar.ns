const native_bool_not: fn(bool) -> bool = .bool_not'builtin
const native_bool_and: fn(bool, bool) -> bool = .bool_and'builtin
const native_bool_or: fn(bool, bool) -> bool = .bool_or'builtin
const native_bool_xor: fn(bool, bool) -> bool = .bool_xor'builtin
const native_bool_then: fn(bool, Any) -> Any = .bool_then'builtin

impl bool {
    pub fn to_i64(self) -> i64 { if self { 1 } else { 0 } }
    pub fn negate(self) -> bool { native_bool_not(self) }
    -- Both arguments are evaluated. Named to avoid the `and`/`or` keywords.
    pub fn bitand(self, other: bool) -> bool { native_bool_and(self, other) }
    pub fn bitor(self, other: bool) -> bool { native_bool_or(self, other) }
    pub fn xor(self, other: bool) -> bool { native_bool_xor(self, other) }
    -- True yields `value`. False yields null.
    pub fn then(self, value: Any) -> Any { native_bool_then(self, value) }
}

impl i64 {
    pub fn is_zero(self) -> bool { self == 0 }
    pub fn is_negative(self) -> bool { self < 0 }
    pub fn is_positive(self) -> bool { self > 0 }
    pub fn count_ones(self) -> i64 { native_count_ones(self) }
    pub fn count_zeros(self) -> i64 { native_count_zeros(self) }
    pub fn leading_zeros(self) -> i64 { native_leading_zeros(self) }
    pub fn trailing_zeros(self) -> i64 { native_trailing_zeros(self) }
    pub fn leading_ones(self) -> i64 { native_leading_ones(self) }
    pub fn trailing_ones(self) -> i64 { native_trailing_ones(self) }
    pub fn reverse_bits(self) -> i64 { native_reverse_bits(self).as(i64) }
    pub fn swap_bytes(self) -> i64 { native_swap_bytes(self).as(i64) }
    pub fn rotate_left(self, distance: i64) -> i64 { native_rotate_left(self, distance).as(i64) }
    pub fn rotate_right(self, distance: i64) -> i64 { native_rotate_right(self, distance).as(i64) }
    pub fn is_power_of_two(self) -> bool { native_is_power_of_two(self) }
    pub fn ilog2(self) -> ?i64 { native_ilog2(self) }
    pub fn ilog10(self) -> ?i64 { native_ilog10(self) }
    pub fn abs_diff(self, other: i64) -> u64 { native_abs_diff(self, other).as(u64) }
    pub fn wrapping_add(self, other: i64) -> i64 { native_wrapping_add(self, other).as(i64) }
    pub fn wrapping_sub(self, other: i64) -> i64 { native_wrapping_sub(self, other).as(i64) }
    pub fn wrapping_mul(self, other: i64) -> i64 { native_wrapping_mul(self, other).as(i64) }
    pub fn wrapping_neg(self) -> i64 { native_wrapping_neg(self).as(i64) }
    pub fn saturating_add(self, other: i64) -> i64 { native_saturating_add(self, other).as(i64) }
    pub fn saturating_sub(self, other: i64) -> i64 { native_saturating_sub(self, other).as(i64) }
    pub fn saturating_mul(self, other: i64) -> i64 { native_saturating_mul(self, other).as(i64) }
    pub fn saturating_neg(self) -> i64 { native_saturating_neg(self).as(i64) }
    pub fn checked_add(self, other: i64) -> ?i64 { optional_i64(native_checked_add(self, other)) }
    pub fn checked_sub(self, other: i64) -> ?i64 { optional_i64(native_checked_sub(self, other)) }
    pub fn checked_mul(self, other: i64) -> ?i64 { optional_i64(native_checked_mul(self, other)) }
    pub fn checked_div(self, other: i64) -> ?i64 { optional_i64(native_checked_div(self, other)) }
    pub fn checked_rem(self, other: i64) -> ?i64 { optional_i64(native_checked_rem(self, other)) }
    pub fn checked_neg(self) -> ?i64 { optional_i64(native_checked_neg(self)) }
    pub fn div_euclid(self, other: i64) -> i64 { native_int_div_euclid(self, other).as(i64) }
    pub fn rem_euclid(self, other: i64) -> i64 { native_int_rem_euclid(self, other).as(i64) }
    pub fn unsigned_abs(self) -> u64 { native_unsigned_abs(self).as(u64) }
    pub fn midpoint(self, other: i64) -> i64 { native_int_midpoint(self, other).as(i64) }
    pub fn checked_shl(self, distance: i64) -> ?i64 { optional_i64(native_checked_shl(self, distance)) }
    pub fn checked_shr(self, distance: i64) -> ?i64 { optional_i64(native_checked_shr(self, distance)) }
    pub fn wrapping_shl(self, distance: i64) -> i64 { native_wrapping_shl(self, distance).as(i64) }
    pub fn wrapping_shr(self, distance: i64) -> i64 { native_wrapping_shr(self, distance).as(i64) }
    pub fn checked_pow(self, exponent: i64) -> ?i64 { optional_i64(native_checked_pow(self, exponent)) }
    pub fn wrapping_pow(self, exponent: i64) -> i64 { native_wrapping_pow(self, exponent).as(i64) }
    pub fn saturating_pow(self, exponent: i64) -> i64 { native_saturating_pow(self, exponent).as(i64) }
    pub fn wrapping_div(self, other: i64) -> i64 { native_wrapping_div(self, other).as(i64) }
    pub fn wrapping_rem(self, other: i64) -> i64 { native_wrapping_rem(self, other).as(i64) }
    pub fn saturating_abs(self) -> i64 { native_saturating_abs(self).as(i64) }
    pub fn checked_abs(self) -> ?i64 { optional_i64(native_checked_abs(self)) }
    pub fn wrapping_abs(self) -> i64 { native_wrapping_abs(self).as(i64) }
    pub fn signum(self) -> i64 { native_int_signum(self) }
    pub fn checked_ilog(self, base: i64) -> ?i64 { optional_i64(native_checked_ilog(self, base)) }
