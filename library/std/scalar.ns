fn optional_i64(value: Any) -> ?i64 { if value == null { null } else { value.as(i64) } }
fn optional_u64(value: Any) -> ?u64 { if value == null { null } else { value.as(u64) } }
fn optional_i128(value: Any) -> ?i128 { if value == null { null } else { value.as(i128) } }
fn optional_u128(value: Any) -> ?u128 { if value == null { null } else { value.as(u128) } }
fn optional_isize(value: Any) -> ?isize { if value == null { null } else { value.as(isize) } }
fn optional_usize(value: Any) -> ?usize { if value == null { null } else { value.as(usize) } }

-- A radix outside 2..=36 is a runtime error. Malformed text, a bad sign, or overflow is null.
pub fn i64_from_str_radix(text: String, radix: i64) -> ?i64 { optional_i64(native_i64_from_str_radix(text, radix)) }
pub fn u64_from_str_radix(text: String, radix: i64) -> ?u64 { optional_u64(native_u64_from_str_radix(text, radix)) }
pub fn i128_from_str_radix(text: String, radix: i64) -> ?i128 { optional_i128(native_i128_from_str_radix(text, radix)) }
pub fn u128_from_str_radix(text: String, radix: i64) -> ?u128 { optional_u128(native_u128_from_str_radix(text, radix)) }
pub fn isize_from_str_radix(text: String, radix: i64) -> ?isize { optional_isize(native_i64_from_str_radix(text, radix)) }
pub fn usize_from_str_radix(text: String, radix: i64) -> ?usize { optional_usize(native_u64_from_str_radix(text, radix)) }

-- The list must contain 8 bytes for a 64-bit value, or 16 bytes for a 128-bit value.
pub fn i64_from_be_bytes(bytes: List) -> i64 { native_i64_from_be_bytes(bytes).as(i64) }
pub fn i64_from_le_bytes(bytes: List) -> i64 { native_i64_from_le_bytes(bytes).as(i64) }
pub fn u64_from_be_bytes(bytes: List) -> u64 { native_u64_from_be_bytes(bytes).as(u64) }
pub fn u64_from_le_bytes(bytes: List) -> u64 { native_u64_from_le_bytes(bytes).as(u64) }
pub fn i128_from_be_bytes(bytes: List) -> i128 { native_i128_from_be_bytes(bytes).as(i128) }
pub fn i128_from_le_bytes(bytes: List) -> i128 { native_i128_from_le_bytes(bytes).as(i128) }
pub fn u128_from_be_bytes(bytes: List) -> u128 { native_u128_from_be_bytes(bytes).as(u128) }
pub fn u128_from_le_bytes(bytes: List) -> u128 { native_u128_from_le_bytes(bytes).as(u128) }
pub fn isize_from_be_bytes(bytes: List) -> isize { native_i64_from_be_bytes(bytes).as(isize) }
pub fn isize_from_le_bytes(bytes: List) -> isize { native_i64_from_le_bytes(bytes).as(isize) }
pub fn usize_from_be_bytes(bytes: List) -> usize { native_u64_from_be_bytes(bytes).as(usize) }
pub fn usize_from_le_bytes(bytes: List) -> usize { native_u64_from_le_bytes(bytes).as(usize) }

