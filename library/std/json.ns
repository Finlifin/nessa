-- std.json — native RFC 8259 JSON parser, serializer, `object { ... }` builder, and typed `Json` / `decode` support.

use .builtin.*
use .traits.*

private const native_to_string: fn(Any) -> String = .to_string'builtin
private const native_type_of: fn(Any) -> Type = .type_of'builtin
private const native_list_is_empty: fn(List) -> bool = .list_is_empty'builtin
private const native_list_len: fn(List) -> i64 = .__list_len'builtin
private const native_list_get: fn(List, usize) -> Any = .__list_get'builtin
private const native_map_init: fn() -> Map = .__map_init'builtin
private const native_map_set: fn(Map, String, Any) -> Unit = .__map_set'builtin
private const native_map_merge: fn(Map, Map) -> Unit = .map_merge'builtin

private const native_parse_dynamic: fn(String) -> (i64, i64, String, Any) = .__json_parse_dynamic'builtin
private const native_stringify_dynamic: fn(Any, bool) -> (i64, String, String) = .__json_stringify_dynamic'builtin
private const native_tape_open: fn(String) -> (i64, i64, String) = .__json_tape_open'builtin
private const native_tape_close: fn(i64) -> Unit = .__json_tape_close'builtin
private const native_tape_kind: fn(i64, i64) -> i64 = .__json_tape_kind'builtin
private const native_tape_read_bool: fn(i64, i64) -> (i64, bool, String) = .__json_tape_read_bool'builtin
private const native_tape_read_int: fn(i64, i64, i64) -> (i64, Any, String) = .__json_tape_read_int'builtin
private const native_tape_read_float: fn(i64, i64, bool) -> (i64, Any, String) = .__json_tape_read_float'builtin
private const native_tape_read_str: fn(i64, i64, bool) -> (i64, Any, String) = .__json_tape_read_str'builtin
private const native_writer_new: fn(i64) -> i64 = .__json_writer_new'builtin
private const native_writer_op: fn(i64, i64, Any) -> i64 = .__json_writer_op'builtin
private const native_writer_finish: fn(i64) -> (i64, String, String) = .__json_writer_finish'builtin
private const native_writer_close: fn(i64) -> Unit = .__json_writer_close'builtin

pub enum JsonError {
    pub UnexpectedEof(offset: i64),
    pub UnexpectedToken(offset: i64, message: String),
    pub InvalidNumber(offset: i64, message: String),
    pub InvalidString(offset: i64, message: String),
    pub InvalidEscape(offset: i64, message: String),
    pub TrailingCharacters(offset: i64),
    pub UnsupportedValue(message: String),
    pub DepthLimitExceeded,
    pub TypeMismatch(path: String, expected: String, actual: String),
    pub MissingField(path: String, field: String),
    pub UnknownField(path: String, field: String),
    pub InvalidVariant(path: String, type_name: String, variant: String),
    pub IntegerOutOfRange(path: String, value: String, target_type: String),
    pub CycleDetected,
}
derive Eq, PartialEq for JsonError

impl Display for JsonError {
    pub fn to_string(self) -> String {
        self match {
            JsonError.UnexpectedEof(offset) => "UnexpectedEof at byte " ++ native_to_string(offset),
            JsonError.UnexpectedToken(offset, message) => "UnexpectedToken at byte " ++ native_to_string(offset) ++ ": " ++ message,
            JsonError.InvalidNumber(offset, message) => "InvalidNumber at byte " ++ native_to_string(offset) ++ ": " ++ message,
            JsonError.InvalidString(offset, message) => "InvalidString at byte " ++ native_to_string(offset) ++ ": " ++ message,
            JsonError.InvalidEscape(offset, message) => "InvalidEscape at byte " ++ native_to_string(offset) ++ ": " ++ message,
            JsonError.TrailingCharacters(offset) => "TrailingCharacters at byte " ++ native_to_string(offset),
            JsonError.UnsupportedValue(message) => "UnsupportedValue: " ++ message,
            JsonError.DepthLimitExceeded => "DepthLimitExceeded",
            JsonError.TypeMismatch(path, expected, actual) => "TypeMismatch at " ++ path ++ ": expected " ++ expected ++ ", found " ++ actual,
            JsonError.MissingField(path, field) => "MissingField at " ++ path ++ ": missing required field '" ++ field ++ "'",
            JsonError.UnknownField(path, field) => "UnknownField at " ++ path ++ ": unknown field '" ++ field ++ "'",
            JsonError.InvalidVariant(path, type_name, variant) => "InvalidVariant at " ++ path ++ ": unknown variant '" ++ variant ++ "' for " ++ type_name,
            JsonError.IntegerOutOfRange(path, value, target_type) => "IntegerOutOfRange at " ++ path ++ ": " ++ value ++ " does not fit in " ++ target_type,
            JsonError.CycleDetected => "CycleDetected",
        }
    }
}

private fn decode_syntax_error(code: i64, offset: i64, msg: String) -> JsonError {
    when {
        code == 1 => JsonError.UnexpectedEof(offset)
        code == 2 => JsonError.UnexpectedToken(offset, msg)
        code == 3 => JsonError.InvalidNumber(offset, msg)
        code == 4 => JsonError.InvalidString(offset, msg)
        code == 5 => JsonError.InvalidEscape(offset, msg)
        code == 6 => JsonError.TrailingCharacters(offset)
        code == 8 => JsonError.DepthLimitExceeded
        else => JsonError.UnexpectedToken(offset, msg)
    }
}

private fn kind_tag_name(kind: i64) -> String {
    when {
        kind == 1 => "null"
        kind == 2 => "bool"
        kind == 3 => "integer"
        kind == 4 => "float"
        kind == 5 => "string"
        kind == 6 => "array"
        kind == 7 => "object"
        else => "invalid"
    }
}

private fn dynamic_value_kind(val: Any) -> String {
    if val == null {
        return "null"
    }
    let ty = native_type_of(val)
    when {
        ty == bool => "bool"
        ty == i8 or ty == i16 or ty == i32 or ty == i64 or ty == i128 or ty == isize => "integer"
        ty == u8 or ty == u16 or ty == u32 or ty == u64 or ty == u128 or ty == usize => "integer"
        ty == f32 or ty == f64 => "float"
        ty == String or ty == char => "string"
        ty == List => "array"
        ty == Map => "object"
        ty == Unit => "null"
        else => native_to_string(ty)
    }
}

private fn reformat_pretty(raw: String, indent: i64) -> !JsonError String {
    if indent <= 0 {
        return raw
    }
    let w = native_writer_new(indent)
    let _ = native_writer_op(w, 10, raw)
    let (code, msg, out) = native_writer_finish(w)
    native_writer_close(w)
    if code == 0 {
        return out
    }
    if code == 8 {
        return error JsonError.DepthLimitExceeded
    }
    if code == 14 {
        return error JsonError.CycleDetected
    }
    error JsonError.UnsupportedValue(msg)
}

pub fn parse(text: String) -> !JsonError Any {
    let (code, offset, msg, val) = native_parse_dynamic(text)
    if code == 0 {
        return val
    }
    error decode_syntax_error(code, offset, msg)
}

pub fn stringify(value: Any, .indent: i64 = 0) -> !JsonError String {
    let (code, msg, out) = native_stringify_dynamic(value, false)
    if code != 0 {
        if code == 8 {
            return error JsonError.DepthLimitExceeded
        }
        if code == 14 {
            return error JsonError.CycleDetected
        }
        return error JsonError.UnsupportedValue(msg)
    }
    if indent <= 0 {
        out
    } else {
        reformat_pretty(out, indent)
    }
}

pub fn encode(value: Json, .indent: i64 = 0) -> !JsonError String {
    value.to_json_string(indent = indent)
}

impl Json {
    pub fn to_json_string(self, .indent: i64 = 0) -> !JsonError String {
        let raw = self.to_json()!
        if indent <= 0 {
            raw
        } else {
            reformat_pretty(raw, indent)
        }
    }

    pub fn to_json_pretty(self, .indent: i64 = 2) -> !JsonError String =
        self.to_json_string(indent = indent)
}

-- Build a JSON-ready `Map` using dual-variadic brace syntax:
-- `json.object { name: "nessa", tags: ["fast", "safe"] }`.
-- Positional `(String, Any)` pairs may also be mixed in for non-identifier keys.
pub fn object(...items: List, ...fields: Map) -> Map {
    if native_list_is_empty(items) {
        return fields
    }
    let out = native_map_init()
    let n = native_list_len(items)
    var i: usize = 0
    while i < n {
        let pair = native_list_get(items, i).as((String, Any))
        native_map_set(out, pair.0, pair.1)
        i += 1
    }
    native_map_merge(out, fields)
    out
}

-- Decode `input` into `target` (`Json`, `Any`, `Map`, `List`, builtin scalars, or statically
-- dispatched `derive Json` / custom `from_json` types rewritten by compiler resolution).
pub fn decode(target: Type, input: String, .allow_unknown_fields: bool = true) -> !JsonError Any {
    when {
        target == Json or target == Any => parse(input)
        target == Map => {
            let v = parse(input)!
            v match {
                m: Map => m,
                _ => error JsonError.TypeMismatch("$", "object", dynamic_value_kind(v)),
            }
        }
        target == List => {
            let v = parse(input)!
            v match {
                xs: List => xs,
                _ => error JsonError.TypeMismatch("$", "array", dynamic_value_kind(v)),
            }
        }
        target == String => String.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == char => char.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == bool => bool.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == Unit => Unit.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == i8 => i8.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == i16 => i16.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == i32 => i32.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == i64 => i64.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == i128 => i128.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == isize => isize.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == u8 => u8.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == u16 => u16.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == u32 => u32.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == u64 => u64.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == u128 => u128.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == usize => usize.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == f32 => f32.from_json(input, allow_unknown_fields = allow_unknown_fields)
        target == f64 => f64.from_json(input, allow_unknown_fields = allow_unknown_fields)
        else => error JsonError.UnsupportedValue(
            "json.decode requires a static `Json` type or builtin JSON target, got " ++ native_to_string(target),
        )
    }
}

-- Signature template bound by resolution for `derive Json` static `from_json` methods.
private fn __derived_from_json_sig(input: String, .allow_unknown_fields: bool = true) -> Unit {
    let _ = input
    let _ = allow_unknown_fields
}

private fn scalar_to_json(v: Any) -> !JsonError String {
    let w = native_writer_new(0)
    let _ = native_writer_op(w, 6, v)
    let (code, msg, out) = native_writer_finish(w)
    native_writer_close(w)
    if code == 0 {
        return out
    }
    if code == 8 {
        return error JsonError.DepthLimitExceeded
    }
    if code == 14 {
        return error JsonError.CycleDetected
    }
    error JsonError.UnsupportedValue(msg)
}

private fn open_tape(input: String) -> !JsonError i64 {
    let (code, handle_or_off, msg) = native_tape_open(input)
    if code == 0 {
        return handle_or_off
    }
    error decode_syntax_error(code, handle_or_off, msg)
}

private fn read_int_root(input: String, width_tag: i64, type_name: String) -> !JsonError Any {
    let tape = open_tape(input)!
    let (code, val, info) = native_tape_read_int(tape, 0, width_tag)
    native_tape_close(tape)
    if code == 0 {
        return val
    }
    if code == 13 {
        return error JsonError.IntegerOutOfRange("$", info, type_name)
    }
    error JsonError.TypeMismatch("$", type_name, info)
}

private fn read_float_root(input: String, is_f32: bool, type_name: String) -> !JsonError Any {
    let tape = open_tape(input)!
    let (code, val, info) = native_tape_read_float(tape, 0, is_f32)
    native_tape_close(tape)
    if code == 0 {
        return val
    }
    if code == 13 {
        return error JsonError.IntegerOutOfRange("$", info, type_name)
    }
    error JsonError.TypeMismatch("$", type_name, info)
}

-- ── Builtin scalar `Json` implementations & `from_json` decoders ───────────

impl Json for i8 {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl i8 {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError i8 {
        let _ = allow_unknown_fields
        read_int_root(input, 0, "i8")!.as(i8)
    }
}

impl Json for i16 {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl i16 {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError i16 {
        let _ = allow_unknown_fields
        read_int_root(input, 1, "i16")!.as(i16)
    }
}

