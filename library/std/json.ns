}
impl f32 {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError f32 {
        let _ = allow_unknown_fields
        read_float_root(input, true, "f32")!.as(f32)
    }
}

impl Json for f64 {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl f64 {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError f64 {
        let _ = allow_unknown_fields
        read_float_root(input, false, "f64")!.as(f64)
    }
}

impl Json for bool {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl bool {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError bool {
        let _ = allow_unknown_fields
        let tape = open_tape(input)!
        let (code, val, info) = native_tape_read_bool(tape, 0)
        native_tape_close(tape)
        if code == 0 {
            return val
        }
        error JsonError.TypeMismatch("$", "bool", info)
    }
}

impl Json for char {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl char {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError char {
        let _ = allow_unknown_fields
        let tape = open_tape(input)!
        let (code, val, info) = native_tape_read_str(tape, 0, true)
        native_tape_close(tape)
        if code == 0 {
            return val.as(char)
        }
        error JsonError.TypeMismatch("$", "char", info)
    }
}

impl Json for String {
    pub fn to_json(self) -> !JsonError String { scalar_to_json(self) }
}
impl String {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError String {
        let _ = allow_unknown_fields
        let tape = open_tape(input)!
        let (code, val, info) = native_tape_read_str(tape, 0, false)
        native_tape_close(tape)
        if code == 0 {
            return val.as(String)
        }
        error JsonError.TypeMismatch("$", "String", info)
    }
}

impl Json for Unit {
    pub fn to_json(self) -> !JsonError String {
        let _ = self
        "null"
    }
}
impl Unit {
    pub fn from_json(input: String, .allow_unknown_fields: bool = true) -> !JsonError Unit {
        let _ = allow_unknown_fields
        let tape = open_tape(input)!
        let kind = native_tape_kind(tape, 0)
        native_tape_close(tape)
        if kind == 1 {
            return ()
        }
        error JsonError.TypeMismatch("$", "null", kind_tag_name(kind))
    }
}
