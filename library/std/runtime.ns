-- std.runtime — garbage collection control, JIT telemetry, and call-stack introspection.

use .builtin.*
use .collections.List
use .traits.*

private const native_rt_gc_collect: fn(i64) -> i64 = .__rt_gc_collect'builtin
private const native_rt_backtrace: fn(?String, i64) -> String = .__rt_backtrace'builtin
private const native_host_call: fn(String, List) -> (bool, Any) = .__host_call'builtin
private const native_rt_jit_enabled: fn() -> bool = .__rt_jit_enabled'builtin
private const native_rt_jit_compiled_fns: fn() -> usize = .__rt_jit_compiled_fns'builtin
private const native_rt_jit_code_bytes: fn() -> usize = .__rt_jit_code_bytes'builtin
private const native_rt_jit_deopt_count: fn() -> usize = .__rt_jit_deopt_count'builtin
private const native_to_string_raw: fn(Any) -> String = .to_string'builtin

pub fn version() -> String = "Nessa 0.1.0"

pub const panic: fn(Any) -> NoReturn = .panic'builtin

pub fn assert(condition: bool, .message: Any = "assertion failed") -> Unit {
    if not condition { panic(message) }
}

pub fn assert_eq(left: Any, right: Any, .message: Any = "values are not equal") -> Unit {
    if left != right { panic(message) }
}

pub fn error_message(err: Any) -> String {
    err match {
        shown: Display => shown.to_string(),
        _ => native_to_string_raw(err),
    }
}

pub fn collect_garbage() -> i64 = native_rt_gc_collect(0)

pub fn gc_collections() -> i64 = native_rt_gc_collect(1)

pub fn jit_enabled() -> bool = native_rt_jit_enabled()

pub fn jit_compiled_functions() -> usize = native_rt_jit_compiled_fns()

pub fn jit_code_bytes() -> usize = native_rt_jit_code_bytes()

pub fn jit_deopt_count() -> usize = native_rt_jit_deopt_count()

pub fn backtrace(.message: ?String = null, .skip: i64 = 1) -> String {
    native_rt_backtrace(message, skip)
}

pub fn host_call(op: String, args: List) -> !String Any {
    let (ok, payload) = native_host_call(op, args)
    if ok {
        payload
    } else {
        error payload.as(String)
    }
}
