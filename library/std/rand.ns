-- std.rand — Xoshiro256** PRNG, host-entropy VM RNG helpers, and random capability effect.

use .builtin.{Any, Bytes, Display, Eq, List, NoReturn, PartialEq, Unit, f64, i64, u8, u64, usize}
use .collections.*
use .scalar.*
use .traits.*

private typealias Bool = .bool'builtin

private const native_rng_next_u64: fn() -> u64 = .__rng_next_u64'builtin
private const native_rng_seed: fn(i64, i64, i64) -> (i64, i64) = .__rng_seed'builtin
private const native_bytes_new: fn(usize) -> Bytes = .__bytes_new'builtin
private const native_bytes_push: fn(Bytes, u8) -> Unit = .__bytes_push'builtin
private const native_panic: fn(Any) -> NoReturn = .panic'builtin

private fn u64_max_val() -> u64 = 0xFFFFFFFFFFFFFFFF
private fn splitmix_gamma() -> u64 = 0x9E3779B97F4A7C15
private fn splitmix_mul1() -> u64 = 0xBF58476D1CE4E5B9
private fn splitmix_mul2() -> u64 = 0x94D049BB133111EB
private fn inv_two_pow_53() -> f64 = 1.0 / 9007199254740992.0

private fn xor_u64(a: u64, b: u64) -> u64 {
    var acc = a
    var rem = b
    while rem != 0 {
        let k = rem.trailing_zeros()
        let bit = rem.isolate_lowest_one()
        if (acc.wrapping_shr(k) % 2) != 0 {
            acc = acc.wrapping_sub(bit)
        } else {
            acc = acc.wrapping_add(bit)
        }
        rem = rem.wrapping_sub(bit)
    }
    acc
}

private fn splitmix64_next(state: u64) -> (u64, u64) {
    let next = state.wrapping_add(splitmix_gamma())
    var z = next
    z = xor_u64(z, z.wrapping_shr(30)).wrapping_mul(splitmix_mul1())
    z = xor_u64(z, z.wrapping_shr(27)).wrapping_mul(splitmix_mul2())
    z = xor_u64(z, z.wrapping_shr(31))
    (next, z)
}

private fn validate_probability(probability: f64) -> Unit {
    if probability != probability or probability < 0.0 or probability > 1.0 {
        native_panic("probability must be in 0.0..=1.0")
    }
}

-- Seedable Xoshiro256** pseudo-random number generator.
pub struct Rng {
    pub s0: u64,
    pub s1: u64,
    pub s2: u64,
    pub s3: u64,
}
derive Eq, PartialEq, Display for Rng

impl Rng {
    pub fn new(.seed: ?u64 = null) -> Rng {
        let initial = seed match {
            val? => val,
            _ => native_rng_next_u64(),
        }
        let (st1, w0_raw) = splitmix64_next(initial)
        let (st2, w1) = splitmix64_next(st1)
        let (st3, w2) = splitmix64_next(st2)
        let (_, w3) = splitmix64_next(st3)
        let w0 = if w0_raw == 0 and w1 == 0 and w2 == 0 and w3 == 0 {
            (1).as(u64)
        } else {
            w0_raw
        }
        Rng { s0: w0, s1: w1, s2: w2, s3: w3 }
    }

    pub fn from_seed(seed_val: u64) -> Rng = Rng.new(seed = seed_val)

    pub fn next_u64(self) -> u64 {
        let result = self.s1.wrapping_mul(5).rotate_left(7).wrapping_mul(9)
        let t = self.s1.wrapping_shl(17)
        self.s2 = xor_u64(self.s2, self.s0)
        self.s3 = xor_u64(self.s3, self.s1)
        self.s1 = xor_u64(self.s1, self.s2)
        self.s0 = xor_u64(self.s0, self.s3)
        self.s2 = xor_u64(self.s2, t)
        self.s3 = self.s3.rotate_left(45)
        result
    }

    pub fn float(self) -> f64 {
        self.next_u64().wrapping_shr(11).as(f64) * inv_two_pow_53()
    }

    pub fn int_range(self, low: i64, high: i64) -> i64 {
        if low > high {
            native_panic("Rng.int_range: interval is empty (low > high)")
        }
        if low == high {
            return low
        }
        let low_u = low.cast_unsigned()
        let span = high.cast_unsigned().wrapping_sub(low_u)
        if span == u64_max_val() {
            return self.next_u64().cast_signed()
        }
        let bound = span.wrapping_add(1)
        let threshold = (0).as(u64).wrapping_sub(bound) % bound
        while true {
            let sample = self.next_u64()
            if sample >= threshold {
                return low_u.wrapping_add(sample % bound).cast_signed()
            }
        }
        low
    }

    pub fn bool(self, .probability: f64 = 0.5) -> Bool {
        validate_probability(probability)
        if probability == 0.0 { return false }
        if probability == 1.0 { return true }
        self.float() < probability
    }

    pub fn choose(self, items: List) -> ?Any {
        let n = items.len()
        if n == 0 {
            return null
        }
        items.get(self.int_range(0, n - 1).as(usize))
    }

    pub fn shuffle(self, items: List) -> Unit {
        var i = items.len() - 1
        while i > 0 {
            let j = self.int_range(0, i)
            items.swap(i.as(usize), j.as(usize))
            i -= 1
        }
    }

    pub fn bytes(self, len: usize) -> Bytes {
        let out = native_bytes_new(len)
        var written: usize = 0
        while written < len {
            var word = self.next_u64()
            var b_idx: i64 = 0
            while b_idx < 8 and written < len {
                native_bytes_push(out, (word % 256).as(u8))
                word = word.wrapping_shr(8)
                written += 1
                b_idx += 1
            }
        }
        out
    }
}

-- Seed the VM-level PRNG (`value = null` reseeds from fresh OS entropy).
pub fn seed(.value: ?u64 = null) -> Unit {
    value match {
        v? => {
            let _ = native_rng_seed(1, v.cast_signed(), 0)
        },
        _ => {
            let _ = native_rng_seed(0, 0, 0)
        },
    }
}

-- Draw the next raw `u64` from the VM-level PRNG.
pub fn next_u64() -> u64 = native_rng_next_u64()

-- Uniform float in `[0.0, 1.0)` with 53 bits of precision.
pub fn float() -> f64 {
    native_rng_next_u64().wrapping_shr(11).as(f64) * inv_two_pow_53()
}

-- Uniform integer in inclusive `[low, high]` using unbiased rejection sampling.
pub fn int_range(low: i64, high: i64) -> i64 {
    if low > high {
        native_panic("rand.int_range: interval is empty (low > high)")
    }
    if low == high {
        return low
    }
    let low_u = low.cast_unsigned()
    let span = high.cast_unsigned().wrapping_sub(low_u)
    if span == u64_max_val() {
        return native_rng_next_u64().cast_signed()
    }
    let bound = span.wrapping_add(1)
    let threshold = (0).as(u64).wrapping_sub(bound) % bound
    while true {
        let sample = native_rng_next_u64()
        if sample >= threshold {
            return low_u.wrapping_add(sample % bound).cast_signed()
        }
    }
    low
}

-- Draw `true` with `probability` in `[0.0, 1.0]`.
pub fn bool(.probability: f64 = 0.5) -> Bool {
    validate_probability(probability)
    if probability == 0.0 { return false }
    if probability == 1.0 { return true }
    float() < probability
}

-- Pick a uniform element from `items`, or `null` when `items` is empty.
pub fn choose(items: List) -> ?Any {
    let n = items.len()
    if n == 0 {
        return null
    }
    items.get(int_range(0, n - 1).as(usize))
}

-- Shuffle `items` in place using the Fisher-Yates algorithm.
pub fn shuffle(items: List) -> Unit {
    var i = items.len() - 1
    while i > 0 {
        let j = int_range(0, i)
        items.swap(i.as(usize), j.as(usize))
        i -= 1
    }
}

-- Generate `len` uniformly distributed random bytes.
pub fn random_bytes(len: usize) -> Bytes {
    let out = native_bytes_new(len)
    var written: usize = 0
    while written < len {
        var word = native_rng_next_u64()
        var b_idx: i64 = 0
        while b_idx < 8 and written < len {
            native_bytes_push(out, (word % 256).as(u8))
            word = word.wrapping_shr(8)
            written += 1
            b_idx += 1
        }
    }
    out
}

-- Random capability effect and deterministic RNG handlers.
pub effect random_u64() -> u64

pub fn with_rng(rng: Rng, thunk: fn() -> #random_u64 Any) -> Any {
    thunk()# {
        random_u64() => rng.next_u64(),
    }
}

pub fn with_seeded_rng(seed_val: u64, thunk: fn() -> #random_u64 Any) -> Any {
    with_rng(Rng.new(seed = seed_val), thunk)
}
