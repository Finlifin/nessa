-- std.rand — VM-level PRNG (Lua 5.4 math.random parity) and pure-Nessa Xoshiro256** Rng.

use .builtin.*
use .collections.*
use .scalar.*

const native_rng_next_u64: fn() -> u64 = .__rng_next_u64'builtin
const native_rng_seed: fn(i64, i64, i64) -> (i64, i64) = .__rng_seed'builtin
const native_panic: fn(Any) -> NoReturn = .panic'builtin

fn u64_max_val() -> u64 = 0xFFFFFFFFFFFFFFFF
fn splitmix_gamma() -> u64 = 0x9E3779B97F4A7C15
fn splitmix_mul1() -> u64 = 0xBF58476D1CE4E5B9
fn splitmix_mul2() -> u64 = 0x94D049BB133111EB
fn inv_two_pow_53() -> f64 = 1.0 / 9007199254740992.0

-- Draw the next raw `u64` from the VM-level PRNG.
pub fn next_u64() -> u64 {
    native_rng_next_u64()
}

-- Uniform float in `[0.0, 1.0)` with 53 bits of precision.
pub fn random() -> f64 {
    native_rng_next_u64().wrapping_shr(11).as(f64) * inv_two_pow_53()
}

-- Uniform integer in inclusive `[low, high]` using unbiased rejection sampling.
-- Panics if `low > high`. Supports the full `[MIN_INTEGER, MAX_INTEGER]` span.
pub fn random_int(low: i64, high: i64) -> i64 {
    if low > high {
        native_panic("random_int: interval is empty (low > high)")
    }
    if low == high {
        return low
    }
    let low_u = low.cast_unsigned()
    let span = high.cast_unsigned().wrapping_sub(low_u)
    if span == u64_max_val() {
        return native_rng_next_u64().cast_signed()
    }
    let bound = span.wrapping_add(1)
    let threshold = (0).as(u64).wrapping_sub(bound) % bound
    while true {
        let sample = native_rng_next_u64()
        if sample >= threshold {
            return low_u.wrapping_add(sample % bound).cast_signed()
        }
    }
    low
}

-- Lua `math.random(n)` helper: `n == 0` draws all 64 random bits as `i64`; `n >= 1` draws from `[1, n]`.
pub fn random_up_to(n: i64) -> i64 {
    if n < 0 {
        native_panic("random_up_to: upper bound must be non-negative")
    }
    if n == 0 {
        return native_rng_next_u64().cast_signed()
    }
    random_int(1, n)
}

-- Seed the VM-level PRNG and return the `(seed1, seed2)` state pair used (Lua 5.4 `math.randomseed`).
-- Calling `seed()` with no arguments seeds from fresh OS/host entropy.
pub fn seed(.s1: ?i64 = null, .s2: ?i64 = null) -> (i64, i64) {
    if s1 == null and s2 == null {
        return native_rng_seed(0, 0, 0)
    }
    if s2 == null {
        return native_rng_seed(1, s1.as(i64), 0)
    }
    let first = if s1 == null { 0 } else { s1.as(i64) }
    native_rng_seed(2, first, s2.as(i64))
}

-- Shuffle `list` in place using the Fisher-Yates algorithm.
pub fn shuffle(list: List) -> Unit {
    var i = list.len() - 1
    while i > 0 {
        let j = random_int(0, i)
        list.swap(i.as(usize), j.as(usize))
        i -= 1
    }
}

-- Pick a uniform element from `list`, or return `null` when `list` is empty.
pub fn choice(list: List) -> Any {
    let n = list.len()
    if n == 0 {
        return null
    }
    list.get(random_int(0, n - 1).as(usize))
}

fn xor_u64(a: u64, b: u64) -> u64 {
    var acc = a
    var rem = b
    while rem != 0 {
        let k = rem.trailing_zeros()
        let bit = rem.isolate_lowest_one()
        if (acc.wrapping_shr(k) % 2) != 0 {
            acc = acc.wrapping_sub(bit)
        } else {
            acc = acc.wrapping_add(bit)
        }
        rem = rem.wrapping_sub(bit)
    }
    acc
}

fn splitmix64_next(state: u64) -> (u64, u64) {
    let next = state.wrapping_add(splitmix_gamma())
    var z = next
    z = xor_u64(z, z.wrapping_shr(30)).wrapping_mul(splitmix_mul1())
    z = xor_u64(z, z.wrapping_shr(27)).wrapping_mul(splitmix_mul2())
    z = xor_u64(z, z.wrapping_shr(31))
    (next, z)
}

-- Deterministic, seedable Xoshiro256** generator implemented in pure Nessa.
pub struct Rng {
    pub s0: u64,
    pub s1: u64,
    pub s2: u64,
    pub s3: u64,
}

impl Rng {
    pub fn from_seed(s1: i64, .s2: i64 = 0) -> Rng {
        let (st1, w0_raw) = splitmix64_next(s1.cast_unsigned())
        let (st2, w1) = splitmix64_next(xor_u64(st1, s2.cast_unsigned()))
        let (st3, w2) = splitmix64_next(st2)
        let (_, w3) = splitmix64_next(st3)
        let w0 = if w0_raw == 0 and w1 == 0 and w2 == 0 and w3 == 0 {
            (1).as(u64)
        } else {
            w0_raw
        }
        Rng { s0: w0, s1: w1, s2: w2, s3: w3 }
    }

    pub fn next_u64(self) -> u64 {
        let result = self.s1.wrapping_mul(5).rotate_left(7).wrapping_mul(9)
        let t = self.s1.wrapping_shl(17)
        self.s2 = xor_u64(self.s2, self.s0)
        self.s3 = xor_u64(self.s3, self.s1)
        self.s1 = xor_u64(self.s1, self.s2)
        self.s0 = xor_u64(self.s0, self.s3)
        self.s2 = xor_u64(self.s2, t)
        self.s3 = self.s3.rotate_left(45)
        result
    }

    pub fn next_f64(self) -> f64 {
        self.next_u64().wrapping_shr(11).as(f64) * inv_two_pow_53()
    }

    pub fn range_int(self, low: i64, high: i64) -> i64 {
        if low > high {
            native_panic("Rng.range_int: interval is empty (low > high)")
        }
        if low == high {
            return low
        }
        let low_u = low.cast_unsigned()
        let span = high.cast_unsigned().wrapping_sub(low_u)
        if span == u64_max_val() {
            return self.next_u64().cast_signed()
        }
        let bound = span.wrapping_add(1)
        let threshold = (0).as(u64).wrapping_sub(bound) % bound
        while true {
            let sample = self.next_u64()
            if sample >= threshold {
                return low_u.wrapping_add(sample % bound).cast_signed()
            }
        }
        low
    }

    pub fn shuffle(self, list: List) -> Unit {
        var i = list.len() - 1
        while i > 0 {
            let j = self.range_int(0, i)
            list.swap(i.as(usize), j.as(usize))
            i -= 1
        }
    }

    pub fn choice(self, list: List) -> Any {
        let n = list.len()
        if n == 0 {
            return null
        }
        list.get(self.range_int(0, n - 1).as(usize))
    }
}
