-- std.bytes — compact GC no-scan `Bytes` buffer, endian I/O, binary packing, UTF-8, hex, and Base64.

use .builtin.*
pub use .builtin.Bytes
use .collections.*
pub use .conv.Utf8Error
use .scalar.*
use .traits.*

const native_bytes_pack: fn(String, List) -> (List, String) = .__bytes_pack'builtin
const native_bytes_packsize: fn(String) -> (i64, String) = .__bytes_packsize'builtin
const native_bytes_unpack: fn(String, List, i64) -> (List, i64, String) = .__bytes_unpack'builtin
const native_str_len: fn(String) -> i64 = .str_len'builtin
const native_byte_at: fn(String, i64) -> i64 = .str_byte_at'builtin
const native_char_at_byte: fn(String, i64) -> ?char = .str_char_at_byte'builtin
const native_char_replacement: fn() -> char = .char_replacement'builtin
const native_from_utf8_lossy: fn(List) -> String = .str_from_utf8_lossy'builtin
const native_contains: fn(String, String) -> bool = .str_contains'builtin
const native_char_from_code: fn(i64) -> ?char = .char_from_code'builtin
const native_into_string: fn(char) -> String = .char_into_string'builtin
const native_to_string: fn(Any) -> String = .to_string'builtin
const native_panic: fn(Any) -> NoReturn = .panic'builtin

private const _bytes_new: fn(usize) -> Bytes = .__bytes_new'builtin
private const _bytes_new_zeroed: fn(usize, usize) -> Bytes = .__bytes_new'builtin
private const _bytes_len: fn(Bytes) -> usize = .__bytes_len'builtin
private const _bytes_cap: fn(Bytes) -> usize = .__bytes_cap'builtin
private const _bytes_get: fn(Bytes, usize) -> u8 = .__bytes_get'builtin
private const _bytes_set: fn(Bytes, usize, u8) -> Unit = .__bytes_set'builtin
private const _bytes_push: fn(Bytes, u8) -> Unit = .__bytes_push'builtin
private const _bytes_clear: fn(Bytes) -> Unit = .__bytes_clear'builtin
private const _bytes_slice: fn(Bytes, usize, usize) -> Bytes = .__bytes_slice'builtin
private const _bytes_copy: fn(Bytes) -> Bytes = .__bytes_copy'builtin
private const _bytes_extend: fn(Bytes, Any) -> Unit = .__bytes_extend'builtin
private const _bytes_from_str: fn(String) -> Bytes = .__bytes_from_str'builtin
private const _bytes_to_str: fn(Bytes) -> Any = .__bytes_to_str'builtin
private const _bytes_from_list: fn(List) -> Bytes = .__bytes_from_list'builtin
private const _bytes_to_list: fn(Bytes) -> List = .__bytes_to_list'builtin
private const _bytes_find: fn(Bytes, Any, usize) -> Any = .__bytes_find'builtin
private const _bytes_read_u64_le: fn(Bytes, usize) -> u64 = .__bytes_read_u64_le'builtin

pub enum PackError {
    pub InvalidFormat(message: String),
    pub DataTooShort(message: String),
    pub ValueOutOfRange(message: String),
    pub PackFailed(message: String),
}

derive Eq, PartialEq for PackError

impl Display for PackError {
    pub fn to_string(self) -> String {
        self match {
            PackError.InvalidFormat(message) => "invalid pack format: " ++ message,
            PackError.DataTooShort(message) => "pack data too short: " ++ message,
            PackError.ValueOutOfRange(message) => "pack value out of range: " ++ message,
            PackError.PackFailed(message) => "pack operation failed: " ++ message,
        }
    }
}

pub enum DecodeError {
    pub InvalidLength(len: usize),
    pub InvalidByte(offset: usize, ch: char),
    pub InvalidPadding,
}

derive Eq, PartialEq for DecodeError

impl Display for DecodeError {
    pub fn to_string(self) -> String {
        self match {
            DecodeError.InvalidLength(len) => "invalid encoded length: " ++ native_to_string(len),
            DecodeError.InvalidByte(offset, ch) => {
                "invalid encoded character '" ++ native_to_string(ch) ++ "' at byte offset " ++ native_to_string(offset)
            },
            DecodeError.InvalidPadding => "invalid Base64 padding",
        }
    }
}

fn classify_pack_error(err_msg: String) -> PackError {
    if native_contains(err_msg, "data string too short")
        or native_contains(err_msg, "unfinished string for format 'z'") {
        return PackError.DataTooShort(err_msg)
    }
    if native_contains(err_msg, "invalid format option")
        or native_contains(err_msg, "missing size")
        or native_contains(err_msg, "size overflow")
        or native_contains(err_msg, "integral size")
        or native_contains(err_msg, "alignment")
        or native_contains(err_msg, "invalid next option")
        or native_contains(err_msg, "variable-length format")
        or native_contains(err_msg, "format result too large") {
        return PackError.InvalidFormat(err_msg)
    }
    if native_contains(err_msg, "integer overflow")
        or native_contains(err_msg, "unsigned overflow")
        or native_contains(err_msg, "does not fit")
        or native_contains(err_msg, "longer than given size")
        or native_contains(err_msg, "byte value out of range")
        or native_contains(err_msg, "initial position out of string")
        or native_contains(err_msg, "string contains zeros") {
        return PackError.ValueOutOfRange(err_msg)
    }
    PackError.PackFailed(err_msg)
}

fn nibble_to_hex_str(nib: i64) -> String {
    let code = if nib < 10 { 48 + nib } else { 87 + nib }
    native_into_string(native_char_from_code(code).as(char))
}

fn hex_byte_to_nibble(b: i64) -> i64 {
    when {
        b >= 48 and b <= 57 => b - 48
        b >= 65 and b <= 70 => b - 55
        b >= 97 and b <= 102 => b - 87
        else => -1
    }
}

fn char_at_or_replacement(text: String, offset: usize) -> char {
    native_char_at_byte(text, offset.as(i64)) match {
        ch? => ch,
        _ => native_char_replacement(),
    }
}

fn b64_encode_sextet(v: i64) -> String {
    let code = when {
        v < 26 => 65 + v
        v < 52 => 97 + (v - 26)
        v < 62 => 48 + (v - 52)
        v == 62 => 43
        else => 47
    }
    native_into_string(native_char_from_code(code).as(char))
}

fn b64_decode_byte(b: i64) -> i64 {
    when {
        b >= 65 and b <= 90 => b - 65
        b >= 97 and b <= 122 => b - 97 + 26
        b >= 48 and b <= 57 => b - 48 + 52
        b == 43 => 62
        b == 47 => 63
        else => -1
    }
}

pub struct BytesIter {
    source: Bytes,
    index: usize,
    total: usize,
}

impl Iterator for BytesIter {
    assoc Item: Type = u8
    pub fn next(self) -> IterationStep(u8) {
        if self.index < self.total {
            let b = _bytes_get(self.source, self.index)
            self.index += 1
            IterationStep(u8).yielded(b)
        } else {
            IterationStep(u8).done
        }
    }
}

impl IntoIterator for BytesIter {
    assoc Iter: Type = BytesIter
    pub fn into_iter(self) -> BytesIter = self
}

impl Bytes {
    pub fn new() -> Bytes {
        _bytes_new(0)
    }

    pub fn with_capacity(capacity: usize) -> Bytes {
        _bytes_new(capacity)
    }

    pub fn zeroed(len: usize) -> Bytes {
        _bytes_new_zeroed(len, len)
    }

    pub fn from_string(text: String) -> Bytes {
        _bytes_from_str(text)
    }

    pub fn from_list(items: List) -> Bytes {
        _bytes_from_list(items)
    }

    pub fn to_list(self) -> List {
        _bytes_to_list(self)
    }

    pub fn to_utf8(self) -> ?String {
        let decoded = _bytes_to_str(self)
        if decoded == null { null } else { decoded.as(String) }
    }

    pub fn decode_utf8(self) -> ?String {
        self.to_utf8()
    }

    pub fn to_utf8_lossy(self) -> String {
        let decoded = _bytes_to_str(self)
        if decoded != null {
            decoded.as(String)
        } else {
            native_from_utf8_lossy(_bytes_to_list(self))
        }
    }

    -- Strict RFC 3629 UTF-8 validator returning the Unicode scalar count or `Utf8Error.InvalidByte(offset)`.
    pub fn validate_utf8(self) -> !Utf8Error usize {
        let total = _bytes_len(self)
        var pos: usize = 0
        var count: usize = 0
        while pos < total {
            let b0 = _bytes_get(self, pos).as(i64)
            if b0 <= 0x7F {
                pos += 1
                count += 1
            } else if b0 >= 0xC2 and b0 <= 0xDF {
                if pos + 1 >= total {
                    return error Utf8Error.InvalidByte(pos)
                }
                let b1 = _bytes_get(self, pos + 1).as(i64)
                if b1 < 0x80 or b1 > 0xBF {
                    return error Utf8Error.InvalidByte(pos)
                }
                pos += 2
                count += 1
            } else if b0 >= 0xE0 and b0 <= 0xEF {
                if pos + 2 >= total {
                    return error Utf8Error.InvalidByte(pos)
                }
                let b1 = _bytes_get(self, pos + 1).as(i64)
                let b2 = _bytes_get(self, pos + 2).as(i64)
                let b1_ok = if b0 == 0xE0 {
                    b1 >= 0xA0 and b1 <= 0xBF
                } else if b0 == 0xED {
                    b1 >= 0x80 and b1 <= 0x9F
                } else {
                    b1 >= 0x80 and b1 <= 0xBF
                }
                if (not b1_ok) or b2 < 0x80 or b2 > 0xBF {
                    return error Utf8Error.InvalidByte(pos)
                }
                pos += 3
                count += 1
            } else if b0 >= 0xF0 and b0 <= 0xF4 {
                if pos + 3 >= total {
                    return error Utf8Error.InvalidByte(pos)
                }
                let b1 = _bytes_get(self, pos + 1).as(i64)
                let b2 = _bytes_get(self, pos + 2).as(i64)
                let b3 = _bytes_get(self, pos + 3).as(i64)
                let b1_ok = if b0 == 0xF0 {
                    b1 >= 0x90 and b1 <= 0xBF
                } else if b0 == 0xF4 {
                    b1 >= 0x80 and b1 <= 0x8F
                } else {
                    b1 >= 0x80 and b1 <= 0xBF
                }
                if (not b1_ok) or b2 < 0x80 or b2 > 0xBF or b3 < 0x80 or b3 > 0xBF {
                    return error Utf8Error.InvalidByte(pos)
                }
                pos += 4
                count += 1
            } else {
                return error Utf8Error.InvalidByte(pos)
            }
        }
        count
    }

    -- Checked UTF-8 decode returning `Utf8Error.InvalidByte(offset)` on malformed sequences.
    pub fn to_string_utf8(self) -> !Utf8Error String {
        let fast = _bytes_to_str(self)
        if fast != null {
            return fast.as(String)
        }
        let _ = self.validate_utf8()!
        ""
    }

    -- Encode `self` as lowercase hexadecimal text.
    pub fn to_hex(self) -> String {
        let total = _bytes_len(self)
        let pieces = List()
        var idx: usize = 0
        while idx < total {
            let b = _bytes_get(self, idx).as(i64)
            pieces.push(nibble_to_hex_str(b / 16))
            pieces.push(nibble_to_hex_str(b % 16))
            idx += 1
        }
        pieces.join("")
    }

    -- Decode hexadecimal text into `Bytes`.
    pub fn from_hex(hex: String) -> !DecodeError Bytes {
        let total = native_str_len(hex).as(usize)
        if total % 2 != 0 {
            return error DecodeError.InvalidLength(total)
        }
        let out = _bytes_new(total / 2)
        var idx: usize = 0
        while idx < total {
            let b0 = native_byte_at(hex, idx.as(i64))
            let hi = hex_byte_to_nibble(b0)
            if hi < 0 {
                return error DecodeError.InvalidByte(idx, char_at_or_replacement(hex, idx))
            }
            let b1 = native_byte_at(hex, (idx + 1).as(i64))
            let lo = hex_byte_to_nibble(b1)
            if lo < 0 {
                return error DecodeError.InvalidByte(idx + 1, char_at_or_replacement(hex, idx + 1))
            }
            _bytes_push(out, (hi * 16 + lo).as(u8))
            idx += 2
        }
        out
    }

    -- Encode `self` using standard RFC 4648 Base64 with `=` padding.
    pub fn to_base64(self) -> String {
        let total = _bytes_len(self)
        let pieces = List()
        var idx: usize = 0
        while idx + 3 <= total {
            let b0 = _bytes_get(self, idx).as(i64)
            let b1 = _bytes_get(self, idx + 1).as(i64)
            let b2 = _bytes_get(self, idx + 2).as(i64)
            pieces.push(b64_encode_sextet(b0 / 4))
            pieces.push(b64_encode_sextet((b0 % 4) * 16 + (b1 / 16)))
            pieces.push(b64_encode_sextet((b1 % 16) * 4 + (b2 / 64)))
            pieces.push(b64_encode_sextet(b2 % 64))
            idx += 3
        }
        let rem = total - idx
        if rem == 1 {
            let b0 = _bytes_get(self, idx).as(i64)
            pieces.push(b64_encode_sextet(b0 / 4))
            pieces.push(b64_encode_sextet((b0 % 4) * 16))
            pieces.push("=")
            pieces.push("=")
        } else if rem == 2 {
            let b0 = _bytes_get(self, idx).as(i64)
            let b1 = _bytes_get(self, idx + 1).as(i64)
            pieces.push(b64_encode_sextet(b0 / 4))
            pieces.push(b64_encode_sextet((b0 % 4) * 16 + (b1 / 16)))
            pieces.push(b64_encode_sextet((b1 % 16) * 4))
            pieces.push("=")
        }
        pieces.join("")
    }

    -- Decode standard RFC 4648 Base64 with `=` padding into `Bytes`.
    pub fn from_base64(b64: String) -> !DecodeError Bytes {
        let total = native_str_len(b64).as(usize)
        if total == 0 {
            return _bytes_new(0)
        }
        if total % 4 != 0 {
            return error DecodeError.InvalidLength(total)
        }
        let three_u: usize = 3
        let out = _bytes_new((total / 4) * three_u)
        var idx: usize = 0
        while idx < total {
            let c0 = native_byte_at(b64, idx.as(i64))
            let c1 = native_byte_at(b64, (idx + 1).as(i64))
            let c2 = native_byte_at(b64, (idx + 2).as(i64))
            let c3 = native_byte_at(b64, (idx + 3).as(i64))
            let is_last = (idx + 4) == total

            if c0 == 61 or c1 == 61 {
                return error DecodeError.InvalidPadding
            }
            let v0 = b64_decode_byte(c0)
            if v0 < 0 {
                return error DecodeError.InvalidByte(idx, char_at_or_replacement(b64, idx))
            }
            let v1 = b64_decode_byte(c1)
            if v1 < 0 {
                return error DecodeError.InvalidByte(idx + 1, char_at_or_replacement(b64, idx + 1))
            }

            if c2 == 61 {
                if (not is_last) or c3 != 61 or (v1 % 16) != 0 {
                    return error DecodeError.InvalidPadding
                }
                _bytes_push(out, (v0 * 4 + (v1 / 16)).as(u8))
            } else if c3 == 61 {
                let v2 = b64_decode_byte(c2)
                if v2 < 0 {
                    return error DecodeError.InvalidByte(idx + 2, char_at_or_replacement(b64, idx + 2))
                }
                if (not is_last) or (v2 % 4) != 0 {
                    return error DecodeError.InvalidPadding
                }
                _bytes_push(out, (v0 * 4 + (v1 / 16)).as(u8))
                _bytes_push(out, ((v1 % 16) * 16 + (v2 / 4)).as(u8))
            } else {
                let v2 = b64_decode_byte(c2)
                if v2 < 0 {
                    return error DecodeError.InvalidByte(idx + 2, char_at_or_replacement(b64, idx + 2))
                }
                let v3 = b64_decode_byte(c3)
                if v3 < 0 {
                    return error DecodeError.InvalidByte(idx + 3, char_at_or_replacement(b64, idx + 3))
                }
                _bytes_push(out, (v0 * 4 + (v1 / 16)).as(u8))
                _bytes_push(out, ((v1 % 16) * 16 + (v2 / 4)).as(u8))
                _bytes_push(out, ((v2 % 4) * 64 + v3).as(u8))
            }
            idx += 4
        }
        out
    }

    -- Pack `values` into a new `Bytes` buffer according to `fmt`.
    pub fn pack(fmt: String, ...values: List) -> !PackError Bytes {
        pack_list(fmt, values)
    }

    -- Unpack values from `self` starting at 0-based byte offset `pos`, returning `(values, next_pos)`.
    pub fn unpack(self, fmt: String, .pos: usize = 0) -> !PackError (List, usize) {
        let (values, next_pos, err_msg) = native_bytes_unpack(fmt, _bytes_to_list(self), pos.as(i64))
        if err_msg != "" {
            return error classify_pack_error(err_msg)
        }
        (values, next_pos.as(usize))
    }

    pub fn len(self) -> usize {
        _bytes_len(self)
    }

    pub fn is_empty(self) -> bool {
        _bytes_len(self) == 0
    }

    pub fn capacity(self) -> usize {
        _bytes_cap(self)
    }

    pub fn get(self, index: usize) -> u8 {
        _bytes_get(self, index)
    }

    pub fn apply(self, index: usize) -> u8 {
        _bytes_get(self, index)
    }

    pub fn set(self, index: usize, value: u8) -> Unit {
        _bytes_set(self, index, value)
    }

    pub fn update(self, index: usize, value: u8) -> Unit {
        _bytes_set(self, index, value)
    }

    pub fn push(self, value: u8) -> Unit {
        _bytes_push(self, value)
    }

    pub fn append(self, other: Bytes) -> Unit {
        _bytes_extend(self, other)
    }

    pub fn `extend`(self, other: Any) -> Unit {
        _bytes_extend(self, other)
    }

    pub fn append_str(self, text: String) -> Unit {
        _bytes_extend(self, text)
    }

    pub fn extend_str(self, text: String) -> Unit {
        _bytes_extend(self, text)
    }

    pub fn clear(self) -> Unit {
        _bytes_clear(self)
    }

    pub fn slice(self, start: usize, end: usize) -> Bytes {
        _bytes_slice(self, start, end)
    }

    pub fn copy(self) -> Bytes {
        _bytes_copy(self)
    }

    pub fn iter(self) -> BytesIter {
        let total = _bytes_len(self)
        BytesIter {
            source: _bytes_slice(self, 0, total),
            index: 0,
            total: total,
        }
    }

    pub fn find(self, needle: Bytes, .start: usize = 0) -> ?usize {
        let pos = _bytes_find(self, needle, start)
        if pos == null { null } else { pos.as(usize) }
    }

    pub fn find_str(self, needle: String, .start: usize = 0) -> ?usize {
        let pos = _bytes_find(self, needle, start)
        if pos == null { null } else { pos.as(usize) }
    }

    -- Endian readers at 0-based byte `offset`.
    pub fn read_u16_le(self, offset: usize) -> u16 {
        let b0 = _bytes_get(self, offset).as(u64)
        let b1 = _bytes_get(self, offset + 1).as(u64)
        (b0 + (b1 * 256)).as(u16)
    }

    pub fn read_u16_be(self, offset: usize) -> u16 {
        let b0 = _bytes_get(self, offset).as(u64)
        let b1 = _bytes_get(self, offset + 1).as(u64)
        ((b0 * 256) + b1).as(u16)
    }

    pub fn read_u32_le(self, offset: usize) -> u32 {
        let b0 = _bytes_get(self, offset).as(u64)
        let b1 = _bytes_get(self, offset + 1).as(u64)
        let b2 = _bytes_get(self, offset + 2).as(u64)
        let b3 = _bytes_get(self, offset + 3).as(u64)
        (b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)).as(u32)
    }

    pub fn read_u32_be(self, offset: usize) -> u32 {
        let b0 = _bytes_get(self, offset).as(u64)
        let b1 = _bytes_get(self, offset + 1).as(u64)
        let b2 = _bytes_get(self, offset + 2).as(u64)
        let b3 = _bytes_get(self, offset + 3).as(u64)
        ((b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3).as(u32)
    }

    pub fn read_u64_le(self, offset: usize) -> u64 {
        _bytes_read_u64_le(self, offset)
    }

    pub fn read_u64_be(self, offset: usize) -> u64 {
        _bytes_read_u64_le(self, offset).swap_bytes()
    }

    -- Endian writers appending encoded integers to `self`.
    pub fn write_u16_le(self, value: u16) -> Unit {
        let v = value.as(u64)
        _bytes_push(self, (v % 256).as(u8))
        _bytes_push(self, ((v / 256) % 256).as(u8))
    }

    pub fn write_u16_be(self, value: u16) -> Unit {
        let v = value.as(u64)
        _bytes_push(self, ((v / 256) % 256).as(u8))
        _bytes_push(self, (v % 256).as(u8))
    }

    pub fn write_u32_le(self, value: u32) -> Unit {
        let v = value.as(u64)
        _bytes_push(self, (v % 256).as(u8))
        _bytes_push(self, ((v / 256) % 256).as(u8))
        _bytes_push(self, ((v / 65536) % 256).as(u8))
        _bytes_push(self, ((v / 16777216) % 256).as(u8))
    }

    pub fn write_u32_be(self, value: u32) -> Unit {
        let v = value.as(u64)
        _bytes_push(self, ((v / 16777216) % 256).as(u8))
        _bytes_push(self, ((v / 65536) % 256).as(u8))
        _bytes_push(self, ((v / 256) % 256).as(u8))
        _bytes_push(self, (v % 256).as(u8))
    }

    pub fn write_u64_le(self, value: u64) -> Unit {
        var rem = value
        var i: usize = 0
        let mask: u64 = 256
        while i < 8 {
            _bytes_push(self, (rem % mask).as(u8))
            rem = rem / mask
            i += 1
        }
    }

    pub fn write_u64_be(self, value: u64) -> Unit {
        self.write_u64_le(value.swap_bytes())
    }

    -- In-place endian writers at 0-based byte `offset`.
    pub fn set_u16_le(self, offset: usize, value: u16) -> Unit {
        let v = value.as(u64)
        _bytes_set(self, offset + 1, ((v / 256) % 256).as(u8))
        _bytes_set(self, offset, (v % 256).as(u8))
    }

    pub fn set_u16_be(self, offset: usize, value: u16) -> Unit {
        let v = value.as(u64)
        _bytes_set(self, offset + 1, (v % 256).as(u8))
        _bytes_set(self, offset, ((v / 256) % 256).as(u8))
    }

    pub fn set_u32_le(self, offset: usize, value: u32) -> Unit {
        let v = value.as(u64)
        _bytes_set(self, offset + 3, ((v / 16777216) % 256).as(u8))
        _bytes_set(self, offset + 2, ((v / 65536) % 256).as(u8))
        _bytes_set(self, offset + 1, ((v / 256) % 256).as(u8))
        _bytes_set(self, offset, (v % 256).as(u8))
    }

    pub fn set_u32_be(self, offset: usize, value: u32) -> Unit {
        let v = value.as(u64)
        _bytes_set(self, offset + 3, (v % 256).as(u8))
        _bytes_set(self, offset + 2, ((v / 256) % 256).as(u8))
        _bytes_set(self, offset + 1, ((v / 65536) % 256).as(u8))
        _bytes_set(self, offset, ((v / 16777216) % 256).as(u8))
    }

    pub fn set_u64_le(self, offset: usize, value: u64) -> Unit {
        if offset + 8 > _bytes_len(self) {
            native_panic("Bytes.set_u64_le: offset out of bounds")
        }
        var rem = value
        var i: usize = 0
        let mask: u64 = 256
        while i < 8 {
            _bytes_set(self, offset + i, (rem % mask).as(u8))
            rem = rem / mask
            i += 1
        }
    }

    pub fn set_u64_be(self, offset: usize, value: u64) -> Unit {
        self.set_u64_le(offset, value.swap_bytes())
    }
}

impl IntoIterator for Bytes {
    assoc Iter: Type = BytesIter
    pub fn into_iter(self) -> BytesIter = self.iter()
}

-- ============================================================================
-- Module-Level `Bytes` Functions
-- ============================================================================

-- Pack `values` into `Bytes` according to `fmt`.
pub fn pack_list(fmt: String, values: List) -> !PackError Bytes {
    let (packed, err_msg) = native_bytes_pack(fmt, values)
    if err_msg != "" {
        return error classify_pack_error(err_msg)
    }
    _bytes_from_list(packed)
}

-- Variadic binary packing into `Bytes`.
pub fn pack(fmt: String, ...values: List) -> !PackError Bytes {
    pack_list(fmt, values)
}

-- Compute the fixed byte size of `fmt`, or fail on variable-length options (`s`, `z`).
pub fn pack_size(fmt: String) -> !PackError i64 {
    let (sz, err_msg) = native_bytes_packsize(fmt)
    if err_msg != "" or sz < 0 {
        return error classify_pack_error(err_msg)
    }
    sz
}

-- Unpack values from `data` starting at 0-based byte offset `pos`, returning `(values, next_pos)`.
pub fn unpack(fmt: String, data: Bytes, .pos: usize = 0) -> !PackError (List, usize) {
    data.unpack(fmt, pos = pos)
}

-- Convert a UTF-8 `String` into `Bytes`.
pub fn from_string(text: String) -> Bytes = Bytes.from_string(text)

-- Decode `data` as strict UTF-8, returning `null` if invalid.
pub fn to_utf8(data: Bytes) -> ?String = data.to_utf8()

-- Decode `data` as UTF-8, replacing invalid sequences with U+FFFD.
pub fn to_utf8_lossy(data: Bytes) -> String = data.to_utf8_lossy()

-- Validate `data` as strict RFC 3629 UTF-8, returning the scalar count or `Utf8Error`.
pub fn validate_utf8(data: Bytes) -> !Utf8Error usize = data.validate_utf8()

-- Decode `data` as checked UTF-8, returning `Utf8Error` on invalid bytes.
pub fn to_string_utf8(data: Bytes) -> !Utf8Error String = data.to_string_utf8()

-- Encode `data` as lowercase hexadecimal text.
pub fn to_hex(data: Bytes) -> String = data.to_hex()

-- Decode hexadecimal text into `Bytes`.
pub fn from_hex(hex: String) -> !DecodeError Bytes = Bytes.from_hex(hex)

-- Encode `data` using standard RFC 4648 Base64 with `=` padding.
pub fn to_base64(data: Bytes) -> String = data.to_base64()

-- Decode standard RFC 4648 Base64 with `=` padding into `Bytes`.
pub fn from_base64(b64: String) -> !DecodeError Bytes = Bytes.from_base64(b64)
