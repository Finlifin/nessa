;;; 08_closure_pipeline.el --- Closure pipeline benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-map-vec (src f)
  (let* ((n (length src))
         (out (make-vector n 0))
         (i 0))
    (while (< i n)
      (aset out i (funcall f (aref src i)))
      (setq i (1+ i)))
    out))

(defun bench-filter-vec (src pred)
  (let* ((n (length src))
         (tmp nil)
         (i 0))
    (while (< i n)
      (let ((v (aref src i)))
        (when (funcall pred v)
          (setq tmp (cons v tmp))))
      (setq i (1+ i)))
    (vconcat (nreverse tmp))))

(defun bench-fold-vec (src init step)
  (let ((acc init)
        (n (length src))
        (i 0))
    (while (< i n)
      (setq acc (funcall step acc (aref src i)))
      (setq i (1+ i)))
    acc))

(defun bench-run-closure (size rounds)
  (let ((base (make-vector size 0))
        (grand-total 0)
        (i 0)
        (r 0))
    (while (< i size)
      (aset base i (% (+ (* i 17) 5) 1000))
      (setq i (1+ i)))
    (while (< r rounds)
      (let* ((offset (+ (* r 3) 7))
             (scale (+ (% r 5) 2))
             (mapped (bench-map-vec base (lambda (x) (+ (* x scale) offset))))
             (filtered (bench-filter-vec mapped (lambda (x) (/= (% x 3) 0))))
             (folded (bench-fold-vec filtered 0
                                     (lambda (acc x)
                                       (% (+ acc x offset) 1000000007)))))
        (setq grand-total (% (+ grand-total folded) 1000000007)))
      (setq r (1+ r)))
    grand-total))

(defun bench-main ()
  (let* ((t0 (float-time))
         (ans (bench-run-closure 10000 25))
         (ms (* (- (float-time) t0) 1000.0)))
    (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms ans))))
