;;; 05_list_quicksort.el --- Vector Quicksort benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-quicksort (arr lo hi)
  (when (< lo hi)
    (let* ((mid (+ lo (/ (- hi lo) 2)))
           (pivot (aref arr mid))
           (i lo)
           (j hi))
      (while (<= i j)
        (while (< (aref arr i) pivot)
          (setq i (1+ i)))
        (while (> (aref arr j) pivot)
          (setq j (1- j)))
        (when (<= i j)
          (let ((tmp (aref arr i)))
            (aset arr i (aref arr j))
            (aset arr j tmp))
          (setq i (1+ i))
          (setq j (1- j))))
      (when (< lo j)
        (bench-quicksort arr lo j))
      (when (< i hi)
        (bench-quicksort arr i hi)))))

(defun bench-run-quicksort (n rounds)
  (let ((seed 1234567)
        (checksum 0)
        (r 0))
    (while (< r rounds)
      (let ((arr (make-vector n 0))
            (k 0))
        (while (< k n)
          (setq seed (% (+ (* seed 48271) 12345) 1000000007))
          (aset arr k (% seed 1000000))
          (setq k (1+ k)))
        (bench-quicksort arr 0 (1- n))
        (setq checksum (+ checksum
                          (aref arr 0)
                          (aref arr (/ n 2))
                          (aref arr (1- n)))))
      (setq r (1+ r)))
    checksum))

(defun bench-main ()
  (let* ((t0 (float-time))
         (ans (bench-run-quicksort 20000 8))
         (ms (* (- (float-time) t0) 1000.0)))
    (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms ans))))
