;;; 03_float_mandelbrot.el --- Mandelbrot float benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-mandelbrot (size max-iter)
  (let ((total-iters 0)
        (fsize (float size))
        (y 0))
    (while (< y size)
      (let ((ci (- (/ (* 2.0 y) fsize) 1.0))
            (x 0))
        (while (< x size)
          (let ((cr (- (/ (* 2.0 x) fsize) 1.5))
                (zr 0.0)
                (zi 0.0)
                (iter 0)
                (escaped nil))
            (while (and (< iter max-iter) (not escaped))
              (let ((zr2 (* zr zr))
                    (zi2 (* zi zi)))
                (if (> (+ zr2 zi2) 4.0)
                    (setq escaped t)
                  (setq zi (+ (* 2.0 zr zi) ci))
                  (setq zr (+ (- zr2 zi2) cr))
                  (setq iter (1+ iter)))))
            (setq total-iters (+ total-iters iter)))
          (setq x (1+ x))))
      (setq y (1+ y)))
    total-iters))

(defun bench-main ()
  (let* ((t0 (float-time))
         (ans (bench-mandelbrot 400 100))
         (ms (* (- (float-time) t0) 1000.0)))
    (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms ans))))
