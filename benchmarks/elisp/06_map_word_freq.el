;;; 06_map_word_freq.el --- Hash-table word frequency benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-run-map (num-keys rounds)
  (let ((keys (make-vector num-keys nil))
        (mp (make-hash-table :test 'equal))
        (i 0)
        (r 0))
    (while (< i num-keys)
      (aset keys i (concat "word_key_" (number-to-string i)))
      (setq i (1+ i)))
    (while (< r rounds)
      (let ((delta (1+ (% r 7)))
            (idx 0))
        (while (< idx num-keys)
          (let* ((k (aref keys idx))
                 (prev (gethash k mp)))
            (puthash k (if prev (+ prev delta) delta) mp))
          (setq idx (1+ idx))))
      (setq r (1+ r)))
    (let ((sum (hash-table-count mp))
          (j 0))
      (while (< j num-keys)
        (setq sum (+ sum (* (gethash (aref keys j) mp) (1+ (% j 11)))))
        (setq j (1+ j)))
      sum)))

(defun bench-main ()
  (let* ((t0 (float-time))
         (ans (bench-run-map 1500 100))
         (ms (* (- (float-time) t0) 1000.0)))
    (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms ans))))
