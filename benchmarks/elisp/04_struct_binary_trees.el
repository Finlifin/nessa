;;; 04_struct_binary_trees.el --- Binary trees GC benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-make-tree (item depth)
  (if (<= depth 0)
      (vector item nil nil)
    (let ((next-depth (1- depth)))
      (vector item
              (bench-make-tree (1- (* 2 item)) next-depth)
              (bench-make-tree (* 2 item) next-depth)))))

(defun bench-check-tree (node)
  (let ((left (aref node 1)))
    (if (null left)
        (aref node 0)
      (+ (aref node 0)
         (- (bench-check-tree left)
            (bench-check-tree (aref node 2)))))))

(defun bench-run-trees ()
  (let* ((min-depth 4)
         (max-depth 13)
         (stretch (bench-make-tree 0 (1+ max-depth)))
         (total-check (bench-check-tree stretch))
         (long-lived (bench-make-tree 0 max-depth))
         (depth min-depth))
    (while (<= depth max-depth)
      (let ((iterations (ash 1 (+ (- max-depth depth) min-depth)))
            (chk 0)
            (i 1))
        (while (<= i iterations)
          (setq chk (+ chk (bench-check-tree (bench-make-tree i depth))))
          (setq chk (+ chk (bench-check-tree (bench-make-tree (- i) depth))))
          (setq i (1+ i)))
        (setq total-check (+ total-check chk)))
      (setq depth (+ depth 2)))
    (+ total-check (bench-check-tree long-lived))))

(defun bench-main ()
  (let* ((t0 (float-time))
         (ans (bench-run-trees))
         (ms (* (- (float-time) t0) 1000.0)))
    (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms ans))))
