;;; 02_int_sieve_lcg.el --- Sieve and LCG benchmark -*- lexical-binding: t; -*-
(setq max-lisp-eval-depth 50000)

(defun bench-run-sieve (limit)
  (let ((flags (make-vector (1+ limit) t))
        (p 2)
        (count 0)
        (i 2))
    (aset flags 0 nil)
    (aset flags 1 nil)
    (while (<= (* p p) limit)
      (when (aref flags p)
        (let ((k (* p p)))
          (while (<= k limit)
            (aset flags k nil)
            (setq k (+ k p)))))
      (setq p (1+ p)))
    (while (<= i limit)
      (when (aref flags i)
        (setq count (1+ count)))
      (setq i (1+ i)))
    count))

(defun bench-run-lcg (steps seed)
  (let ((state seed)
        (acc 0)
        (i 0))
    (while (< i steps)
      (setq state (% (+ (* state 48271) 12345) 1000000007))
      (setq acc (% (+ acc (% state 65536)) 1000000007))
      (setq i (1+ i)))
    acc))

(defun bench-main ()
  (let* ((t0 (float-time))
         (prime-sum 0)
         (r 0))
    (while (< r 40)
      (setq prime-sum (+ prime-sum (bench-run-sieve 50000)))
      (setq r (1+ r)))
    (let* ((lcg-acc (bench-run-lcg 2000000 42))
           (checksum (+ (* prime-sum 1000) (% lcg-acc 1000)))
           (ms (* (- (float-time) t0) 1000.0)))
      (princ (format "KERNEL_MS:%.6f\nCHECKSUM:%d\n" ms checksum)))))
